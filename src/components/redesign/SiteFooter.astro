---
import {eventNavigation as events} from '../../data/occasion-events';
import {cities} from '../../data/brand';
interface Props {checkHref?:string}
const {checkHref='/check-your-date/'}=Astro.props;
const ways=[{name:'Full service',href:'/full-service-photo-booth-rental/'},{name:'Self-service',href:'/self-service-photo-booth-rental/'},{name:'Shipped nationwide',href:'/photo-booth-by-mail/'},{name:'360 video booth',href:'/360-photo-booth-rental/'},{name:'Digital booth',href:'/digital-photo-booth-rental/'},{name:'All packages',href:'/photo-booth-packages/'},{name:'Rental cost guide',href:'/photo-booth-rental-cost/'}];
const company=[{name:'About us',href:'/about-photo-party-city/'},{name:'Contact',href:'/contact-us/'},{name:'Props & backdrops',href:'/photobooth-props/'},{name:'Blog',href:'/blog/'},{name:'Rental terms & refunds',href:'/refund-policy/'},{name:'Shop equipment',href:'/shop-page/'}];
---
<footer class="ppc-footer"><div class="ppc-wrap ppc-footer-inner"><div class="ppc-footgrid">
  <div class="ppc-footer-brand"><a class="ppc-brand" href="/"><span class="ppc-brand-name">Photo Party City</span></a><p>Staffed photo booths within 45 miles of Mira Loma, CA. Booths shipped anywhere in the continental US.</p><address><span>3827 Wacker Dr., Mira Loma, CA 91752</span><span>Monday–Friday · 9 AM–5 PM Pacific</span><a href="mailto:hello@photopartycity.com">hello@photopartycity.com</a><a href="tel:+19094037143"><strong>Call or text (909) 403-7143</strong></a></address></div>
  <div><p class="ppc-foothead">Ways to rent</p><ul class="ppc-footlinks">{ways.map(item=><li><a href={item.href}>{item.name}</a></li>)}</ul></div>
  <div><p class="ppc-foothead">Events</p><ul class="ppc-footlinks">{events.map(item=><li><a href={item.href}>{item.name}</a></li>)}</ul></div>
  <div><p class="ppc-foothead">Inland Empire</p><ul class="ppc-footlinks">{cities.map(city=><li><a href={`/photo-booth-rental-${city.toLowerCase().replaceAll(' ','-')}/`}>{city}</a></li>)}</ul></div>
  <div><p class="ppc-foothead">Company</p><ul class="ppc-footlinks">{company.map(item=><li><a href={item.href}>{item.name}</a></li>)}</ul></div>
</div><div class="ppc-footer-bottom"><span>© {new Date().getFullYear()} Photo Party City</span><span><a href="https://www.ataphotobooths.com/">Booths made by ATA Photobooths</a><a href="/sitemap-index.xml">Sitemap</a></span></div></div></footer>
<div class="ppc-sticky-pad" aria-hidden="true"></div>
<nav class="ppc-sticky" aria-label="Quick contact" data-source="sticky"><a href={checkHref} class="ppc-btnp">Check your date</a><a href="tel:+19094037143" class="ppc-btng" aria-label="Call/Text (909) 403-7143"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/></svg>Call/Text</a></nav>
