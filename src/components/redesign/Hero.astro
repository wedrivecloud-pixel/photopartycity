---
import Photo from './Photo.astro';
interface Props { eyebrow?: string; title:string; description:string; checkHref?:string; image?:string; imageAlt?:string; tag?:string }
const {eyebrow,title,description,checkHref='/check-your-date/',image,imageAlt='Photo booth at an event',tag}=Astro.props;
---
<section class="ppc-hero-section" data-source="hero">
  <div class="ppc-wrap ppc-hero">
    <div class="ppc-hero-copy">
      {tag && <span class:list={['ppc-tag',{'ppc-tag-blue':tag.toLowerCase().includes('anywhere') || tag.toLowerCase().includes('nationwide')}]}>{tag}</span>}
      {eyebrow && <p class="ppc-eyebrow">{eyebrow}</p>}
      <h1 class="ppc-h1">{title}</h1>
      <p class="ppc-lead">{description}</p>
      <div class="ppc-row"><a class="ppc-btnp" href={checkHref}>Check your date</a><a class="ppc-link" href="tel:+19094037143">Call or text (909) 403-7143</a></div>
      <slot/>
    </div>
    <div class="ppc-hero-media"><Photo label={imageAlt} src={image} alt={imageAlt} ratio="4/3" loading="eager" fetchpriority="high"/></div>
  </div>
</section>
