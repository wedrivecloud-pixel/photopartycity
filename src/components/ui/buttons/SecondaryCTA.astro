---
// Destructure the properties from Astro.props
const { title, url } = Astro.props;

// Define TypeScript interface for the properties
interface Props {
  title?: string;
  url?: string;
}
---

{/* Styled hyperlink */}
<a
  class="ppc-secondary inline-flex items-center justify-center gap-x-2 rounded-lg px-4 py-3 text-center text-sm font-medium shadow-xs transition-colors duration-300 2xl:text-base"
  href={url}
>
  {title}
</a>

<style>
  /* The site uses light surfaces in both system themes. Keep every state opaque
     and give this shared secondary style at least 4.5:1 text contrast. */
  .ppc-secondary {
    color: #241d30 !important;
    background-color: #f0edf2;
    border: 1px solid #6b6274;
  }
  .ppc-secondary:hover {
    background-color: #e5dfe9;
  }
  .ppc-secondary:active {
    background-color: #d9d0df;
  }
  .ppc-secondary:focus-visible {
    outline: 3px solid #54228b;
    outline-offset: 4px;
  }
</style>
