---
import RentalLayout from '../../layouts/RentalLayout.astro';
import Hero from '../redesign/Hero.astro';
import Photo from '../redesign/Photo.astro';
import FAQ from '../redesign/FAQ.astro';
import {fullServiceTiers,selfServiceTiers,addons,booth360Rates,mailRental,mailTerms,money} from '../../data/rentals';
interface Props { page: {slug:string;name:string;title:string;description:string;canonical?:string} }
const {page}=Astro.props;
const isCost=page.slug==='photo-booth-rental-cost';
const isAbout=page.slug==='about-photo-party-city';
const isProps=page.slug==='photobooth-props';
const heading=isCost ? 'A little planning. A clear rental budget.' : isAbout ? 'Good people. Great photo memories.' : isProps ? 'The little details that make it yours.' : 'A few clear terms. A smoother event.';
const description=isCost ? 'Compare our published rental rates, see what’s included, and build a realistic total for your event.' : isAbout ? 'We’re Photo Party City, based in Mira Loma, California. We help you bring people together with a photo booth experience that fits your celebration.' : isProps ? 'Find a backdrop and prop theme that feels right for your wedding, party or team celebration. We’ll confirm your selections with your booking.' : 'Find the booking, cancellation, equipment return and shop return information that applies to your order.';
const metadataDescription=page.description || 'Choose photo booth backdrops and prop themes for weddings, parties and corporate events. Plan your rental details with Photo Party City.';
const label=isCost ? 'Rental cost guide' : isAbout ? 'About Photo Party City' : isProps ? 'Props & backdrops' : 'Policies';
const backdropOptions=[{name:'Geometric',tone:'lav',text:'A graphic pattern for a modern celebration.'},{name:'Leaf',tone:'sage',text:'A botanical look for your photo corner.'},{name:'Flower',tone:'blush',text:'A floral background for your gathering.'},{name:'Wood',tone:'gold',text:'A wood-look design for a rustic setting.'},{name:'Brick Angel Wings',tone:'sky',text:'A playful wall design with angel wings.'}];
const propThemes=[{title:'Weddings & anniversaries',text:'Rustic Love, So This Is Love, and He Put a Ring On It themes help guests celebrate the couple.'},{title:'Birthdays & celebrations',text:'Best Birthday Ever, Where’s the Cake, and Best Party Ever bring a playful touch to group photos.'},{title:'Corporate & team events',text:'Corporate Chic and Let’s Get Social are options to discuss for a team party or branded occasion.'},{title:'School events & themed parties',text:'Prom Squad, Roaring 20s, and Viva La Vogue offer a starting point for your theme. Ask us about an age-appropriate selection.'}];
const faqs=[
 {question:'What is your lowest photo booth rental price?',answer:`Starter is ${money(selfServiceTiers[0].price)} for a 24-hour digital self-service rental. Printing, a physical backdrop and delivery are additional options.`},
 {question:'Is printing included in the Starter price?',answer:`No. Printer rental is ${money(addons.printer)} and a media kit for 100 4×6 prints is ${money(addons.mediaKit)}. Starter plus both items totals ${money(selfServiceTiers[0].price+addons.printer+addons.mediaKit)} before other applicable charges.`},
 {question:'Why do Gold and Platinum cost more?',answer:'Compare both the booth model and the coverage time. Gold uses Lumia M Pro with DSLR capture; Platinum uses Posh Pro with a 37-inch display. Adding time to Silver keeps its original booth model.'},
 {question:'Is delivery included?',answer:'Full-service photo packages list delivery, setup and takedown; your proposal confirms any applicable travel or venue-related charges. Self-service delivery, setup and collection are additional. Confirm 360 arrangements in its separate proposal.'},
 {question:'Can I use these prices as a confirmed quote?',answer:'These are published rates and example combinations. Your booking proposal confirms availability, extras, transport arrangements, applicable taxes or charges, and your final total.'},
 {question:'Can you ship a booth to my event?',answer:`Photo Booth By Mail starts at ${money(mailRental.price)} and serves the continental United States. Ask about available print packages, backdrop choices and optional protection before booking.`},
];
---
<RentalLayout title={page.title} description={metadataDescription} canonical={page.canonical} breadcrumbs={[{name:'Home',href:'/'},{name:label}]} ctaHeading={isAbout ? 'Let’s make your next gathering a good one.' : isProps ? 'Have a theme in mind?' : isCost ? 'Find the right fit for your budget.' : 'Have a question about your booking?'} ctaSub={isProps ? 'Tell us your date and event details. We’ll help with the finishing touches.' : undefined}>
  {isCost ? <div class="cost-guide-hero">
    <Hero title={heading} description={description} eyebrow={label} image="/media/cost-guide/hero.webp" imageAlt="Illustrative scene of hosts planning a celebration with sample photo strips">
      <p class="ppc-small ppc-muted" style="margin:16px 0 0">Illustrative event planning imagery.</p>
    </Hero>
    <style is:inline>.cost-guide-hero .ppc-hero .ppc-ph{min-height:0}</style>
  </div> : <Hero title={heading} description={description} eyebrow={label} imageAlt={isAbout ? 'The Photo Party City team welcoming guests at an event' : isProps ? 'Guests posing with props and a backdrop at a celebration' : 'A photo booth packed and ready for its next celebration'}/>}
  {isCost && <>
    <section class="ppc-section-sm"><div class="ppc-wrap ppc-stack-lg">
      <div class="ppc-stack"><p class="ppc-eyebrow">Start with the experience</p><h2 class="ppc-h2">Four ways to make it happen.</h2><p class="ppc-p">These are Photo Party City’s published rental rates. Compare duration, equipment and service before choosing your package.</p></div>
      <div class="ppc-tablebox" tabindex="0" aria-label="Rental starting prices, scroll horizontally if needed"><table class="ppc-table"><caption class="ppc-sr-only">Rental options at a glance</caption><thead><tr><th scope="col">Experience</th><th scope="col">Starting price</th><th scope="col">The essentials</th></tr></thead><tbody>
        <tr><th scope="row"><a class="ppc-link" href="/full-service-photo-booth-rental/">We bring it</a></th><td class="num">{money(fullServiceTiers[0].price)}</td><td>{fullServiceTiers[0].hours} hours · attendant and prints</td></tr>
        <tr><th scope="row"><a class="ppc-link" href="/self-service-photo-booth-rental/">You pick it up</a></th><td class="num">{money(selfServiceTiers[0].price)}</td><td>24 hours · digital self-service</td></tr>
        <tr><th scope="row"><a class="ppc-link" href="/photo-booth-by-mail/">We ship it</a></th><td class="num">{money(mailRental.price)}</td><td>Continental US · self setup</td></tr>
        <tr><th scope="row"><a class="ppc-link" href="/360-photo-booth-rental/">360 video</a></th><td class="num">{money(booth360Rates.self[2])}</td><td>2 hours · self-service rate</td></tr>
      </tbody></table></div>
      <nav class="ppc-chips" aria-label="Jump to rental prices"><a href="#attended-prices">Full service</a><a href="#digital-prices">Self-service</a><a href="#360-prices">360 video</a><a href="#mail-prices">By mail</a><a href="#example-totals">Example totals</a></nav>
    </div></section>
    <section class="ppc-section ppc-white" id="attended-prices"><div class="ppc-wrap ppc-stack-lg">
      <div class="ppc-stack"><p class="ppc-eyebrow">We bring it</p><h2 class="ppc-h2">Full service, with prints.</h2><p class="ppc-p">An attendant, personalized photo design, backdrop, props, digital copies and a 30-day gallery are included. Your proposal confirms any travel or venue-related charges.</p></div>
      <div class="ppc-tablebox" tabindex="0" aria-label="Full-service pricing, scroll horizontally if needed"><table class="ppc-table"><caption class="ppc-sr-only">Full-service packages</caption><thead><tr><th scope="col">Package</th><th scope="col">Booth model</th><th scope="col">Coverage</th><th scope="col">Starting price</th><th scope="col">Availability</th></tr></thead><tbody>{fullServiceTiers.map(tier=><tr><th scope="row">{tier.name}</th><td>{tier.model}</td><td>{tier.hours} hours</td><td class="num">{money(tier.price)}</td><td><a class="ppc-link" href={tier.href}>Check your date</a></td></tr>)}</tbody></table></div>
      <p class="ppc-p">Extra attended time is {money(addons.extraHour)} per hour, subject to availability. Adding time keeps the booth model in your chosen package.</p>
    </div></section>
    <section class="ppc-section" id="digital-prices"><div class="ppc-wrap ppc-stack-lg">
      <div class="ppc-stack"><p class="ppc-eyebrow">You pick it up</p><h2 class="ppc-h2">A full day of digital fun.</h2><p class="ppc-p">Each self-service package is a 24-hour rental with a one-day minimum. Digital photos, sharing, videos, GIFs, boomerangs, album access and premade templates are included.</p></div>
      <div class="ppc-tablebox" tabindex="0" aria-label="Self-service pricing, scroll horizontally if needed"><table class="ppc-table"><caption class="ppc-sr-only">Digital self-service packages</caption><thead><tr><th scope="col">Package</th><th scope="col">Booth model</th><th scope="col">Rental</th><th scope="col">Base price</th><th scope="col">Availability</th></tr></thead><tbody>{selfServiceTiers.map(tier=><tr><th scope="row">{tier.name}</th><td>{tier.model}</td><td>{tier.hours} hours</td><td class="num">{money(tier.price)}</td><td><a class="ppc-link" href={tier.href}>Check your date</a></td></tr>)}</tbody></table></div>
      <div class="ppc-grid2"><div class="ppc-card ppc-stack"><h3 class="ppc-h3">Choose your extras.</h3><ul class="ppc-checks"><li>Printer rental: {money(addons.printer)}</li><li>Media kit for 100 4×6 prints: {money(addons.mediaKit)}</li><li>Custom-designed template: {money(addons.customTemplate)}</li><li>Physical backdrop: {money(addons.backdrop)}</li></ul></div><div class="ppc-stack"><h3 class="ppc-h3">Plan pickup or delivery.</h3><p class="ppc-p">Pick up and return in Mira Loma. Base self-service rates exclude an attendant, printing, a physical backdrop, delivery, setup and collection. Delivery arrangements are quoted separately.</p><a class="ppc-link" href="/self-service-photo-booth-rental/">Read the self-service details →</a></div></div>
    </div></section>
    <section class="ppc-section ppc-band" id="360-prices"><div class="ppc-wrap ppc-stack-lg"><div class="ppc-stack"><p class="ppc-eyebrow">A different angle</p><h2 class="ppc-h2">360 video booth rates.</h2><p class="ppc-p">360 packages use their own event-hour rates. They do not include the 24-hour period offered by our digital self-service packages.</p></div><div class="ppc-tablebox" tabindex="0" aria-label="360 pricing, scroll horizontally if needed"><table class="ppc-table"><caption class="ppc-sr-only">360 video booth hourly rates</caption><thead><tr><th scope="col">Event time</th><th scope="col">Full service</th><th scope="col">Self-service</th></tr></thead><tbody>{([2,3,4] as const).map(hours=><tr><th scope="row">{hours} hours</th><td class="num">{money(booth360Rates.full[hours])}</td><td class="num">{money(booth360Rates.self[hours])}</td></tr>)}</tbody></table></div><p class="ppc-p">Self-service 360 delivery, setup and pickup are excluded. Confirm guest support, operating hours, space and transport arrangements in your proposal.</p><a class="ppc-link" href="/360-photo-booth-rental/">Explore the 360 experience →</a></div></section>
    <section class="ppc-section ppc-white" id="mail-prices"><div class="ppc-wrap ppc-split ppc-split-top"><div class="ppc-stack"><span class="ppc-tag ppc-tag-blue">Anywhere in the continental US</span><h2 class="ppc-h2">A booth delivered to your door.</h2><p class="ppc-p">A self-setup rental for celebrations beyond our local service area. Select your event date and confirm the delivery and return details in your booking.</p><a class="ppc-link" href="/photo-booth-by-mail/">See how booth by mail works →</a></div><div class="ppc-tablebox" tabindex="0" aria-label="Booth by mail pricing, scroll horizontally if needed"><table class="ppc-table ppc-mail-table"><caption class="ppc-sr-only">Booth by mail rates</caption><thead><tr><th scope="col">Item</th><th scope="col">Price</th></tr></thead><tbody><tr><th scope="row">Photo Booth By Mail</th><td class="num">{money(mailRental.price)}</td></tr><tr><th scope="row">Optional Wi-Fi hotspot</th><td class="num">{money(addons.mailHotspot)}</td></tr><tr><th scope="row">Print packages and damage protection</th><td>Confirm with the team</td></tr></tbody></table></div></div></section>
    <section class="ppc-section" id="example-totals"><div class="ppc-wrap ppc-stack-lg"><div class="ppc-stack"><p class="ppc-eyebrow">Put it together</p><h2 class="ppc-h2">Three example totals.</h2><p class="ppc-p">Listed rental items only. Your proposal confirms applicable taxes, travel, extras and the final total.</p></div><div class="ppc-grid3">
      <article class="ppc-card ppc-stack"><span class="ppc-tag">Digital only</span><h3 class="ppc-h3">Starter for a day</h3><p class="ppc-p">A 24-hour Starter rental. Arrange pickup and return in Mira Loma; manage the booth yourself.</p><p class="ppc-price"><b>{money(selfServiceTiers[0].price)}</b><span>base rental</span></p></article>
      <article class="ppc-card ppc-stack"><span class="ppc-tag">Add keepsakes</span><h3 class="ppc-h3">Starter with 100 prints</h3><p class="ppc-p">Starter, printer rental and one media kit for 100 4×6 prints. Transport and other extras are additional.</p><p class="ppc-price"><b>{money(selfServiceTiers[0].price+addons.printer+addons.mediaKit)}</b><span>example total</span></p></article>
      <article class="ppc-card ppc-stack"><span class="ppc-tag">With an attendant</span><h3 class="ppc-h3">Silver for three hours</h3><p class="ppc-p">The Silver package with an attendant, prints, personalized design, backdrop, props and digital gallery.</p><p class="ppc-price"><b>{money(fullServiceTiers[0].price)}</b><span>starting price</span></p></article>
    </div><a class="ppc-link" href="/photo-booth-packages/">Compare every package →</a></div></section>
    <FAQ items={faqs}/>
  </>}
  {isAbout && <>
    <section class="ppc-section ppc-white"><div class="ppc-wrap ppc-stack-lg"><div class="ppc-stack"><p class="ppc-eyebrow">What matters to us</p><h2 class="ppc-h2">Make room for a little more joy.</h2><p class="ppc-p">Our photo booth experiences are built around the people at your event: the friends squeezing into a frame, the coworkers sharing a laugh, and the family taking one more photo together.</p></div><div class="ppc-grid3">{[{title:'An experience that fits',text:'Choose an attended setup, a local self-service rental, or a booth shipped to your event. We help you compare the practical details.'},{title:'Your event, your style',text:'Personalized photo designs, backdrops and props can bring your celebration’s look into the photos guests take home.'},{title:'Clear plans from the start',text:'Your proposal sets out the selected package, equipment, extras and transport arrangements so you know what you’re booking.'}].map(value=><article class="ppc-card ppc-stack"><h3 class="ppc-h3">{value.title}</h3><p class="ppc-p">{value.text}</p></article>)}</div></div></section>
    <section class="ppc-section"><div class="ppc-wrap ppc-split"><Photo label="Guests holding their photo strips beside a Photo Party City booth" tone="blush"/><div class="ppc-stack"><p class="ppc-eyebrow">The booths behind the memories</p><h2 class="ppc-h2">Meet our ATA booth lineup.</h2><p class="ppc-p">Our packages use Helio Sport, Lumia M Pro and Posh Pro booths. Each offers a different combination of camera, display and service, so you can choose what suits your event.</p><p class="ppc-p">Want simple digital sharing? Prefer printed keepsakes with an attendant? Start with the experience you want, then compare the equipment and inclusions.</p><a class="ppc-link" href="/photo-booth-packages/#ata-photobooths-packages">Meet the booth models →</a><a class="ppc-link" href="https://www.ataphotobooths.com/">Explore ATA Photobooths →</a></div></div></section>
    <section class="ppc-section ppc-band"><div class="ppc-wrap ppc-split ppc-split-top"><div class="ppc-stack"><p class="ppc-eyebrow">Say hello</p><h2 class="ppc-h2">Based in Mira Loma. Part of your celebration.</h2><p class="ppc-p">Staffed rentals serve event locations within 45 miles of Mira Loma. Booth By Mail brings a self-setup option to the continental United States.</p></div><div class="ppc-card ppc-stack"><h3 class="ppc-h3">Visit & pickup</h3><address class="ppc-p">3827 Wacker Dr.<br/>Mira Loma, CA 91752</address><p class="ppc-p">Monday–Friday, 9 AM–5 PM Pacific.<br/>Contact us to arrange your visit, pickup or return.</p><a class="ppc-link" href="tel:+19094037143">Call or text (909) 403-7143</a><a class="ppc-link" href="/contact-us/">Get in touch →</a></div></div></section>
  </>}
  {isProps && <>
    <section class="ppc-section ppc-white"><div class="ppc-wrap ppc-stack-lg"><div class="ppc-stack"><p class="ppc-eyebrow">Set the scene</p><h2 class="ppc-h2">Five local backdrop options.</h2><p class="ppc-p">Our local rental form lists these 8×8-foot designs. A backdrop is included with full-service photo packages and optional for self-service. We’ll confirm the available design for your date. By-mail backdrop options are separate.</p></div><div class="ppc-props-grid">{backdropOptions.map(backdrop=><article class="ppc-card ppc-stack"><Photo label={`${backdrop.name} backdrop`} tone={backdrop.tone}/><h3 class="ppc-h3">{backdrop.name}</h3><p class="ppc-p">{backdrop.text}</p></article>)}</div><a class="ppc-link" href="/photo-booth-packages/">Compare package inclusions →</a></div></section>
    <section class="ppc-section"><div class="ppc-wrap ppc-stack-lg"><div class="ppc-stack"><p class="ppc-eyebrow">Pick your mood</p><h2 class="ppc-h2">A prop theme for your people.</h2><p class="ppc-p">Start with your occasion and let us know what fits your crowd. Themes and quantities are confirmed with your rental.</p></div><div class="ppc-grid2">{propThemes.map(theme=><article class="ppc-card ppc-stack"><h3 class="ppc-h3">{theme.title}</h3><p class="ppc-p">{theme.text}</p></article>)}</div></div></section>
    <section class="ppc-section ppc-band"><div class="ppc-wrap ppc-split ppc-split-top"><div class="ppc-stack"><p class="ppc-eyebrow">Renting or buying?</p><h2 class="ppc-h2">Planning your photo corner.</h2><p class="ppc-p">For a rental, tell us your chosen package, backdrop and occasion when you check your date. If you’re buying props for your own booth, explore the separate shop catalog.</p><a class="ppc-link" href="/shop-page/">Browse props in the shop →</a></div><div class="ppc-card ppc-stack"><h3 class="ppc-h3">A few practical details.</h3><ul class="ppc-checks"><li>Leave room for the backdrop, booth and guest queue.</li><li>Check the venue’s access and setup arrangements.</li><li>Match prop selections to the age range of your guests.</li><li>Confirm a physical backdrop separately from a digital background.</li></ul></div></div></section>
  </>}
  {!isCost && !isAbout && !isProps && <>
    <section class="ppc-section-sm"><div class="ppc-wrap"><nav class="ppc-chips" aria-label="Policy sections"><a href="#booking">Booking</a><a href="#cancellations">Cancellations</a><a href="#equipment-returns">Equipment returns</a><a href="#damage">Damage</a><a href="#shop-returns">Shop returns</a></nav></div></section>
    <section class="ppc-section ppc-white"><div class="ppc-wrap ppc-narrow ppc-prose">
      <section id="booking"><h2>Booking your rental</h2><p>Check your event date and select the package that suits your plans. Availability and your reservation are confirmed through your booking proposal. The proposal sets out your equipment, duration, selected extras, transport arrangements and final charges.</p><p>Your local booking proposal sets out payment timing, deposit requirements and the cancellation or rescheduling terms for your event. If you have a question before accepting, <a href="/contact-us/">contact our team</a>.</p></section>
      <section id="cancellations"><h2>Cancellations</h2><h3>Photo Booth By Mail</h3><p>Cancellations made more than 7 days before the event are eligible for a full refund. Cancellations within 7 days of the event incur a {money(mailTerms.cancellationFee)} cancellation fee.</p><h3>Local rentals</h3><p>Refer to your booking proposal for the cancellation and rescheduling terms that apply to your local rental. Contact us promptly if your plans change so we can review your booking with you.</p></section>
      <section id="equipment-returns"><h2>Returning rental equipment</h2><h3>Photo Booth By Mail</h3><p>Return the booth on the first business day following your event, using the provided return label and UPS drop-off instructions. For weekend events, this is typically Monday; if it is a UPS-recognized holiday, use the next business day.</p><p>A late fee of {money(mailTerms.lateReturnPerDay)} per day, per item may apply to late booth returns unless you arrange otherwise with us in advance. Keep your drop-off receipt and tracking information.</p><h3>Local self-service rentals</h3><p>Agree your pickup and return schedule with the team before your event. Return equipment and included items to the location and at the time stated in your booking proposal.</p></section>
      <section id="damage"><h2>Damage & missing items</h2><p>Please inspect equipment when it arrives or when you pick it up. Contact us promptly if anything is damaged, missing or not working, so we can help before the event.</p><p>Our rental form states that the renter is responsible for damage and late or non-return of rented items. Review the responsibilities and any applicable charges in your booking proposal. Optional accidental damage protection is listed for by-mail rentals; confirm its price, coverage and exclusions before selecting it.</p></section>
      <section id="shop-returns"><h2>Shop purchases & returns</h2><p>The following applies to purchased shop items, separately from rental equipment. Our published shop policy allows you to request a return within 7 days of receiving your item.</p><p>To be eligible, the item must be in the same condition you received it: unused or unworn, with tags and its original packaging. Keep your receipt or proof of purchase.</p><h3>Contact us before sending anything back</h3><p>The published shop returns contact is <a href="mailto:photoboothindustry@gmail.com">photoboothindustry@gmail.com</a>. If your return is accepted, you’ll receive a return label and instructions for where to send the package. Items sent without a return request will not be accepted. For help reaching the right team, <a href="/contact-us/">contact Photo Party City</a>.</p><h3>Damaged or incorrect items</h3><p>Inspect your order when it arrives. Contact the returns team immediately if the item is defective, damaged or incorrect, so they can review the issue.</p><h3>Exceptions</h3><p>The published policy excludes custom or personalized products, sale items and gift cards. Other exclusions may apply to specific products. Ask about eligibility before requesting a return.</p><h3>Exchanges & refunds</h3><p>For an exchange, request the return first; once accepted, make a separate purchase for the replacement. After a return is received and inspected, you’ll be notified whether the refund was approved. Approved refunds go to the original payment method; bank or card processing time can vary.</p></section>
    </div></section>
  </>}
</RentalLayout>
<style>
  .ppc-props-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}.ppc-mail-table{min-width:0}.ppc-prose>section+section{margin-top:56px}.ppc-prose>section>h2:first-child{margin-top:0}.ppc-prose section{scroll-margin-top:32px}address{font-style:normal}
  @media(max-width:960px){.ppc-props-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:560px){.ppc-props-grid{grid-template-columns:minmax(0,1fr)}}
</style>
