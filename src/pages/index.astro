---
import RentalLayout from '../layouts/RentalLayout.astro';
import Photo from '../components/redesign/Photo.astro';
import FAQ from '../components/redesign/FAQ.astro';
import WaysToRent from '../components/redesign/WaysToRent.astro';
import CheckDateForm from '../components/redesign/CheckDateForm.astro';
import {cities} from '../data/brand';
const faqs=[
 {question:'Do you serve my event location?',answer:'Staffed booths and pickup rentals are available within 45 miles of Mira Loma, California, subject to your exact address. Booth by mail is available across the continental United States. Enter your date and ZIP to explore your options.'},
 {question:'What’s the difference between full service and self-service?',answer:'Full service includes an attendant, printing, delivery, setup and takedown during your booked hours. With self-service, you pick up the booth in Mira Loma and operate it for your 24-hour rental. Printing is an optional extra.'},
 {question:'How does booth by mail work?',answer:'We ship a portable booth before your event. Follow the included setup guide, enjoy your celebration, then pack everything in the case and drop it off with the provided UPS return label on the first business day after your event.'},
 {question:'Does checking my date confirm a reservation?',answer:'Checking your date starts the booking process. Availability, delivery arrangements, extras and the final total are confirmed in your proposal. Complete the required booking steps to reserve your booth.'},
];
const events=[
 {name:'Weddings',label:'Illustrative scene of wedding guests showing their photo strips',image:'/media/homepage/wedding.webp',href:'/wedding-photo-booth-rental/',tone:'blush'},
 {name:'Corporate events',label:'Illustrative scene of colleagues celebrating together at a company event',image:'/media/homepage/corporate.webp',href:'/corporate-photo-booth-rental/',tone:'sky'},
 {name:'Birthdays',label:'Illustrative scene of friends celebrating a birthday at a photo booth',image:'/media/homepage/birthday.webp',href:'/self-service-photo-booth-rental/',tone:'gold'},
 {name:'Quinceañeras',label:'Illustrative scene of a quinceañera celebration with family and friends',image:'/media/homepage/quinceanera.webp',href:'/full-service-photo-booth-rental/',tone:'lav'},
 {name:'Graduations',label:'Illustrative scene of graduates celebrating with photo keepsakes',image:'/media/homepage/graduation.webp',href:'/self-service-photo-booth-rental/',tone:'sage'},
 {name:'School events',label:'Illustrative scene of students enjoying a school celebration',image:'/media/homepage/school.webp',href:'/self-service-photo-booth-rental/',tone:'lil'},
];
---
<RentalLayout title="Photo Booth Rentals in Mira Loma & Nationwide | Photo Party City" description="Staffed photo booths near Mira Loma, California, easy pickup rentals, and booths shipped across the continental US. Find the right booth for your celebration." checkHref="#check" ctaHeading="Your date. Your people. Let’s make memories.">
 <section class="home-hero ppc-section-sm" id="check"><div class="ppc-wrap ppc-hero">
  <div class="ppc-stack" style="gap:26px"><p class="ppc-eyebrow">Good times. Great photos. Your kind of party.</p><h1 class="ppc-h1">The party’s better<br/>with a photo booth.</h1><p class="ppc-lead">We bring the booth near Mira Loma. You pick it up. Or we ship it to your door. However you celebrate, make room for the memories.</p><CheckDateForm id="home" home/><a class="ppc-link" href="tel:+19094037143" data-source="hero">Call or text (909) 403-7143</a></div>
  <div class="home-photo-composition"><Photo label="Friends celebrating together" src="/media/2e95e775cef6987a.webp" alt="Four smiling guests holding Team Bride, BFFs and Party Animal photo props" width={600} height={400} loading="eager" fetchpriority="high" tone="lav" ratio="3/2"/><span class="home-photo-note">Your people.<br/>Their moment.</span><div class="ppc-strip home-strip" aria-hidden="true"><img src="/media/2e95e775cef6987a.webp" alt="" width="600" height="400" loading="lazy" decoding="async"/><img src="/media/f8545184ac481dfe.webp" alt="" width="600" height="400" loading="lazy" decoding="async"/><img src="/media/4b60169354289bbe.webp" alt="" width="600" height="400" loading="lazy" decoding="async"/><small>PHOTO PARTY CITY</small></div><span class="home-photo-sticker">Let’s make<br/>some memories.</span></div>
 </div></section>
 <section class="home-trust-strip" aria-label="Made for your celebration"><div class="ppc-wrap ppc-row"><span>Built for the good times.</span><b>Weddings</b><b>Company parties</b><b>Birthdays</b><b>Just-because celebrations</b></div></section>
 <WaysToRent/>
 <section class="ppc-section ppc-band"><div class="ppc-wrap ppc-stack-lg"><div class="ppc-stack"><p class="ppc-eyebrow">A little silly. A lot unforgettable.</p><h2 class="ppc-h2">This is what memories look like.</h2><p class="ppc-p">The big smiles. The unexpected poses. The one photo everyone keeps.</p></div><div class="ppc-wall"><div class="ppc-w2x2"><Photo label="Wedding photo booth memories" src="/media/f8545184ac481dfe.webp" alt="Wedding couple holding Mr. and Mrs. photo props" width={600} height={400} tone="blush" ratio="1/1"/></div><Photo label="Corporate event illustration" src="/media/homepage/corporate.webp" alt="Illustrative scene of colleagues celebrating together at a company event" width={1200} height={800} tone="gold" ratio="1/1"/><Photo label="Graduation event illustration" src="/media/homepage/graduation.webp" alt="Illustrative scene of graduates celebrating with photo keepsakes" width={1200} height={800} tone="sage" ratio="1/1"/><div class="ppc-w2x1"><Photo label="Wedding guests making memories" src="/media/4b60169354289bbe.webp" alt="Laughing wedding couple posing through a heart-shaped frame outdoors" width={600} height={400} tone="sage" ratio="16/9"/></div></div><p class="ppc-small" style="margin:0">Event photos and illustrative scenes.</p></div></section>
 <section id="how-it-works" class="ppc-section"><div class="ppc-wrap ppc-stack-lg"><div class="ppc-stack"><p class="ppc-eyebrow">The easy part of planning</p><h2 class="ppc-h2">More party. Less to figure out.</h2><p class="ppc-p">Choose the way to rent that fits your event. We’ll confirm the details with you.</p></div><div class="ppc-tracks"><article class="ppc-card ppc-stack"><span class="ppc-tag">Near Mira Loma</span><h3 class="ppc-h3">Keep it local.</h3><ol class="ppc-steps"><li>Tell us your date and event address.</li><li>Choose staffed service or a pickup rental.</li><li>Confirm your booth and event arrangements.</li><li>Make some memories with your guests.</li></ol><a class="ppc-link" href="/photo-booth-packages/">Explore local rental options →</a></article><article class="ppc-card ppc-stack"><span class="ppc-tag ppc-tag-blue">Across the continental US</span><h3 class="ppc-h3">Get the party delivered.</h3><ol class="ppc-steps is-outline"><li>Choose your booth-by-mail options.</li><li>Receive the booth before your event.</li><li>Set it up with the included guide.</li><li>Pack it up and return with the UPS label.</li></ol><a class="ppc-link" href="/photo-booth-by-mail/">See how booth by mail works →</a></article></div></div></section>
 <section id="reviews" class="ppc-section-sm ppc-white"><div class="ppc-wrap ppc-split"><div class="ppc-stack"><p class="ppc-eyebrow">For the moments that matter</p><h2 class="ppc-h2">A celebration worth remembering.</h2><p class="ppc-p">Planning a wedding, company event or family party? Tell us what you have in mind. We’ll help you find the experience that fits.</p><a class="ppc-link" href="/contact-us/">Talk with our team →</a></div><div class="ppc-card ppc-stack"><p class="ppc-eyebrow">Guest stories</p><h3 class="ppc-h3">The best part is who’s in the picture.</h3><p class="ppc-p">Our guest stories will live here once their text and sources are confirmed.</p></div></div></section>
 <section class="ppc-section"><div class="ppc-wrap ppc-stack-lg"><div class="ppc-stack"><p class="ppc-eyebrow">Whatever you’re celebrating</p><h2 class="ppc-h2">There’s a booth for that.</h2></div><div class="ppc-events">{events.map(event=><a class="home-event" href={event.href}><Photo label={event.label} src={event.image} alt={event.label} width={1200} height={800} tone={event.tone} ratio="3/2"/><span><b>{event.name}</b><span aria-hidden="true">↗</span></span></a>)}</div><p class="ppc-small" style="margin:0">Illustrative event imagery.</p></div></section>
 <section class="ppc-section ppc-band"><div class="ppc-wrap ppc-area"><div class="ppc-stack"><p class="ppc-eyebrow">Local roots. Far-reaching fun.</p><h2 class="ppc-h2">Based in Mira Loma.<br/>Ready for your celebration.</h2><p class="ppc-p">Staffed booths and pickup rentals serve events within 45 miles of Mira Loma, California. Your exact venue address confirms coverage. Farther away? We ship booths across the continental US.</p><ul class="ppc-chips">{cities.map(city=><li><a href={`/photo-booth-rental-${city.toLowerCase().replaceAll(' ','-')}/`}>{city}</a></li>)}</ul><a class="ppc-link" href="/photo-booth-by-mail/">Explore nationwide booth by mail →</a></div><div class="home-area-art" role="img" aria-label="Local service area within 45 miles of Mira Loma, California"><div class="home-area-ring"><span>Mira Loma, CA<strong>45</strong><span>mile service radius</span></span></div><p>We bring the booth.<br/>You bring your people.</p></div></div></section>
 <FAQ items={faqs} heading="A few good questions."/>
</RentalLayout>
<style>
 .home-hero{padding-top:56px;padding-bottom:80px}.home-photo-composition{position:relative;padding:120px 24px 70px;background:#E6DCF0;border-radius:26px}.home-photo-composition :global(.ppc-ph){width:100%;min-height:0}.home-photo-note{position:absolute;top:34px;left:34px;font-family:var(--font-display);font-size:36px;line-height:1.05;letter-spacing:-.03em;color:var(--accent);transform:rotate(-6deg)}.home-strip{position:absolute;bottom:36px;right:24px;transform:rotate(10deg)}.home-strip>img{display:block;width:100%;height:76px;object-fit:cover}.home-photo-sticker{position:absolute;right:0;top:20px;background:#f3d891;border:1px solid #ebcc7d;width:140px;height:140px;padding:10px;border-radius:50%;display:grid;place-content:center;font-family:var(--font-display);font-size:18px;font-weight:600;text-align:center;line-height:1.1;transform:rotate(10deg)}.home-trust-strip{border-block:1px solid var(--line);padding:22px 0}.home-trust-strip .ppc-row{justify-content:space-between;font-size:14px}.home-trust-strip span{color:var(--muted)}.ppc-wall :global(.ppc-ph){height:100%;aspect-ratio:auto}.home-event{display:block;color:var(--ink);text-decoration:none}.home-event>span{display:flex;justify-content:space-between;align-items:center;padding:14px 2px;font-size:19px}.home-event:hover b{color:var(--accent)}.home-area-art{padding:45px 28px;background:#e6dcf0;border-radius:26px;text-align:center}.home-area-ring{border-radius:50%;width:min(100%,300px);aspect-ratio:1/1;border:1px solid #aa8cbf;outline:1px dashed #bda9ca;outline-offset:-20px;margin:0 auto;display:grid;place-items:center;background:#efe6f3}.home-area-ring strong{display:block;font-family:var(--font-display);font-size:100px;font-weight:600;line-height:1.1;color:var(--accent)}.home-area-art p{font-family:var(--font-display);font-size:26px;line-height:1.2;margin:30px 0 0}.home-area-ring>span{font-size:15px}.home-area-ring>span>span{color:var(--muted)}
 @media(max-width:960px){.home-photo-composition{max-width:560px;width:100%;margin:auto}.home-photo-composition :global(.ppc-ph){width:100%;min-height:0}}@media(max-width:720px){.home-hero{padding:36px 0 56px}.home-photo-note{font-size:26px;left:24px}.home-photo-sticker{font-size:14px;width:108px;height:108px;padding:6px}.home-trust-strip .ppc-row{justify-content:center;text-align:center}.home-area-art{padding:35px 20px}.home-photo-composition{padding-right:18px;padding-left:18px}}
</style>
