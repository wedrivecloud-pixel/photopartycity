---
import Layout from '../layouts/Layout.astro';
import pages from '../data/pages.json';
import {booking} from '../data/brand';
import PageHeading from '../components/PageHeading.astro';
// Pages with a dedicated route in src/pages (e.g. photo-booth-packages.astro) are excluded here.
export function getStaticPaths(){const dedicated=['photo-booth-packages'];return pages.filter(p=>p.slug && !dedicated.includes(p.slug)).map(page=>({params:{slug:page.slug},props:{page}}));}
const {page}=Astro.props;
const backendPages=['cart','checkout','my-account','rental-search','thank-you','search-item-list','rent-grid','rent-list','evercompare'];
const isBackend=backendPages.includes(page.slug);
const isProduct=page.type==='product';
const isArticle=page.type==='post';
const catalog=['shop-page','photobooth-props'].includes(page.slug) || page.type==='archive' && page.path.startsWith('/product-');
const products=pages.filter(p=>p.type==='product' && (!('catalogPaths' in page) || page.catalogPaths?.includes(p.path))); 
let content=page.content;
if(isBackend)content='';
// Plugin shortcode artifacts cannot execute in a static site.
content=content.replace(/\[(?:rbfw_[^\]]*|rent-list[^\]]*|evercompare_table|search-result)\]/g,'');
if(page.slug==='about-photo-party-city'){
 content=content.replace(/<div class="widget widget-elementskit-funfact">\s*<span>0<\/span>\s*\+\s*<h3>[^<]*<\/h3>\s*<\/div>/g,'');
}
// Empty imported sections add spacing but carry no content or anchors.
while(/<section>\s*<\/section>/.test(content))content=content.replace(/<section>\s*<\/section>/g,'');
let gallery='',publishedPrice='';
if(isProduct){
 gallery=content.match(/^<div class="product-gallery">[\s\S]*?<\/div>/)?.[0] ?? '';
 content=content.slice(gallery.length);
 publishedPrice=content.match(/^<p class="catalog-price">[\s\S]*?<\/p>/)?.[0] ?? '';
 content=content.slice(publishedPrice.length);
}
const hasProductImage=gallery.includes('<img') || Boolean(page.image);
---
<Layout {...page} robots={isBackend?'noindex, follow':page.robots}>
<PageHeading title={page.name} description={isProduct ? '' : page.description}><div class="breadcrumbs"><a href="/">Home</a> / {page.name}</div></PageHeading>
<div class:list={['page-body', {'article-page':isArticle, 'product-page':isProduct, 'about-page':page.slug==='about-photo-party-city'}]}>
{isBackend && <aside><h2>Plan your rental with our team</h2><p>Check dates and request a reservation through our booking system. For an existing order or account question, contact us at <a href="tel:+19094037143">(909) 403-7143</a> or <a href="mailto:hello@photopartycity.com">hello@photopartycity.com</a>.</p><a class="book-button" href={booking}>Open booking ↗</a></aside>}
{isProduct && <section class:list={['product-overview',{'product-overview--text-only':!hasProductImage}]} aria-label="Product overview">
 {hasProductImage && <div class="product-media">
  {gallery.includes('<img') ? <Fragment set:html={gallery}/> : page.image && <img src={page.image} alt={page.name} width="640" height="640" loading="eager"/>}
 </div>}
 <div class="product-summary">
  {page.description && <p class="product-description">{page.description}</p>}
  <Fragment set:html={publishedPrice}/>
  <p>For current availability, pricing, and rental or purchase arrangements, <a href="/contact-us/">contact our team</a>. Photo booth rental package rates are listed on our <a href="/photo-booth-packages/">packages page</a>; your proposal confirms the final total.</p>
  <a class="book-button" href="/contact-us/">Ask about this product <span aria-hidden="true">→</span></a>
 </div>
</section>}
<div class="content" set:html={content}></div>
{catalog && <><label class="catalog-controls">Find a photo booth or accessory <input id="catalog-search" type="search" placeholder="Search the catalog…"/></label><div class="cards catalog-grid" id="catalog">{products.map(p=><article class="catalog-card" data-name={p.name.toLowerCase()}>{p.image && <img src={p.image} alt={p.name} loading="lazy" width="300" height="300"/>}<h2><a href={p.path}>{p.name}</a></h2>{p.description && <p class="catalog-description">{p.description}</p>}{'price' in p && <p class="catalog-card-price">Published catalog price: {'priceDisplay' in p ? p.priceDisplay : '$'+Number(p.price).toLocaleString('en-US',{minimumFractionDigits:2})}</p>}<a class="catalog-action" href={p.path}>View details <span aria-hidden="true">→</span></a></article>)}</div><p id="catalog-empty" hidden>No matches. Try a different search or contact our team.</p></>}
</div>
<script>
 const input=document.querySelector<HTMLInputElement>('#catalog-search');input?.addEventListener('input',()=>{
  let matches=0;document.querySelectorAll<HTMLElement>('[data-name]').forEach(card=>{card.hidden=!card.dataset.name?.includes(input.value.toLowerCase().trim());if(!card.hidden)matches++;});
  const empty=document.querySelector<HTMLElement>('#catalog-empty');if(empty)empty.hidden=matches>0;
 });
</script>
</Layout>
