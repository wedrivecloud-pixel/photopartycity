---
import Layout from '../layouts/Layout.astro';
import PageHeading from '../components/PageHeading.astro';
import mail from '../data/photo-booth-by-mail.json';

const description = 'Photo Booth By Mail delivers the fun to your door. Rentals from $275 with free shipping, easy setup, digital sharing, and optional prints.';
const canonical = 'https://photopartycity.com/photo-booth-by-mail/';
const included = ['All night rental!', 'Camera, Stand & Light', 'Sequin Back Drop, Stand & Props', 'Optional Custom Logo*'];
const sharing = ['Pics Texted & Emailed Instantly', 'Customize Your Backdrop', 'Complimentary Props & Delivery', 'Personalized with Your Logo', 'Complete Event Photo Album'];
const schema = {'@context':'https://schema.org', '@type':'WebPage', name:'Photo Booth By Mail', url:canonical, description};
---
<Layout title="Photo Booth By Mail - Photo Party City" description={description} canonical={canonical} image="/media/by-mail/helio-booth.webp" schema={schema}>
 <PageHeading title="Photo Booth By Mail" description={description}>
  <div class="breadcrumbs"><a href="/">Home</a> / Photo Booth By Mail</div>
 </PageHeading>
 <div class="page-body mail-page">
  <div class="content">
   <section aria-labelledby="mail-intro-title">
    <div class="widget widget-text-editor"><p><strong>THE PARTY, DELIVERED</strong></p></div>
    <div class="widget widget-heading"><h2 id="mail-intro-title">How Booth By Mail Works</h2></div>
    <div class="widget widget-text-editor">{mail.blocks['How Booth By Mail Works'].map(text=><p>{text}</p>)}<p>Rentals start at <strong>$275 with free shipping included</strong>. Delivered 1–2 days before your event. Easy setup. All-night fun.</p></div>
    <div class="widget widget-button"><a class="content-cta" href={mail.booking}>Book now <svg class="inline-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10"/></svg></a></div>
    <div class="widget widget-text-editor"><p><a href="#mail-rental">Explore rental options ↓</a> · <a href="/photo-booth-packages/">Compare photo packages</a></p></div>
    <div class="widget widget-image"><img src="/media/by-mail/helio-booth.webp" alt="White Helio ring-light photo booth set up at an event" width="825" height="681" fetchpriority="high"/></div>
    <div class="widget widget-heading"><h2>Easy, Affordable, &amp; Fun</h2></div>
    <div class="widget widget-text-editor">{mail.blocks['Easy, Affordable, & Fun'].map(text=><p>{text}</p>)}</div>
   </section>

   <section aria-labelledby="mail-how-title">
    <div class="widget widget-heading"><h2 id="mail-how-title">How Does It Work?</h2></div>
    {mail.steps.map(step=><><div class="widget widget-heading"><h3>{step.title}</h3></div><div class="widget widget-text-editor"><p>{step.text}</p></div></>)}
    <div class="widget widget-text-editor"><p>Questions? Give us a call at <a href="tel:+19094037143">(909) 403-7143</a>.</p></div>
   </section>

   <section aria-labelledby="mail-included-title">
    <div class="widget widget-heading"><h2 id="mail-included-title">What is Included?</h2></div>
    <div class="widget widget-text-editor">{mail.blocks['What is Included?'].map(text=><p>{text}</p>)}<ul>{included.map(item=><li>{item}</li>)}</ul><p>*Select your backdrop, props, and optional extras below. Your booking confirms the final package and any add-on charges.</p></div>
    <div class="widget widget-image"><img src="/media/by-mail/helio-detail.webp" alt="Helio photo booth equipment packed in its protective travel case" width="600" height="600" loading="lazy"/></div>
    <div class="widget widget-button"><a class="content-cta" href={mail.booking}>Book now</a></div>
   </section>

   <section aria-labelledby="mail-social-title">
    <div class="widget widget-heading"><h2 id="mail-social-title">Get Social Instantly</h2></div>
    <div class="widget widget-text-editor">{mail.blocks['Get Social Instantly'].map(text=><p>{text}</p>)}<ul>{sharing.map(item=><li>{item}</li>)}</ul></div>
    <div class="widget widget-heading"><h3>Sharing Options</h3></div>
    <div class="widget widget-text-editor"><ul><li>Text</li><li>Email</li><li>Airdrop</li></ul><p>Connect to Wi-Fi for instant texts and emails. A hotspot is available for $40.</p></div>
   </section>

   <section aria-labelledby="mail-ai-title">
    <div class="widget widget-heading"><h2 id="mail-ai-title">A.I. Photo Booth</h2></div>
    <div class="widget widget-text-editor">{mail.blocks['A.I. Photo Booth'].map(text=><p>{text}</p>)}</div>
    <div class="widget widget-image"><img src="/media/by-mail/ai-experience.webp" alt="White ring-light photo booth with a colorful geometric backdrop" width="700" height="700" loading="lazy"/></div>
    <div class="widget widget-heading"><h3>What is an AI Photo Booth?</h3></div>
    <div class="widget widget-text-editor">{mail.blocks['What is an AI Photo Booth?'].map(text=><p>{text}</p>)}</div>
    <div class="widget widget-button"><a class="content-cta" href={mail.booking}>Book now</a></div>
    <div class="widget widget-heading"><h2>3 Steps to Amazing AI Photos</h2></div>
    <div class="widget widget-text-editor">{mail.blocks['3 Steps to Amazing AI Photos'].map(text=><p>{text}</p>)}</div>
    <div class="widget widget-heading"><h3>Click, Customize, Share</h3></div>
    {mail.aiSteps.map(step=><><div class="widget widget-heading"><h3>{step.title}</h3></div><div class="widget widget-text-editor"><p>{step.text}</p></div></>)}
    <div class="widget widget-heading"><h3>Hassle-Free Photos Made Easy with Photo Party City AI Photo Booth</h3></div>
    <div class="widget widget-text-editor">{mail.blocks['Hassle-Free Photos Made Easy with Photo Party City AI Photo Booth'].map(text=><p>{text}</p>)}</div>
   </section>

   <section id="mail-rental" aria-labelledby="mail-rental-title">
    <div class="widget widget-text-editor"><p><strong>YOUR EVENT, YOUR WAY</strong></p></div>
    <div class="widget widget-heading"><h2 id="mail-rental-title">Photo Booth By Mail</h2></div>
    <div class="widget widget-price-table"><h3>Photo Booth By Mail — $275</h3><p>Base rental price · Free shipping included</p><p>Choose your backdrop, print package, hotspot, props, and insurance preference. Add-on pricing and availability are confirmed before booking.</p><a class="content-cta" href={mail.booking}>Book through Eventdeskly</a></div>
    <div class="widget widget-text-editor">{mail.blocks['Photo Booth By Mail'].map(text=><p>{text}</p>)}<p>Prefer to ask us first? Complete the options form to prepare an email inquiry.</p></div>
    <form action="mailto:hello@photopartycity.com" method="post" enctype="text/plain" data-inquiry-form="true" data-kind="booth-by-mail" aria-labelledby="mail-form-title">
     <h3 id="mail-form-title">Choose your rental options</h3>
     <p id="mail-form-help">This opens a draft in your email app. You must send the email to submit your inquiry. Your rental is confirmed only after booking.</p>
     <div class="mail-fields">{mail.fields.map(field=><div class:list={['mail-field',{'mail-field-wide':field.name==='Print Packages'}]}><label for={field.id}>{field.name}</label><select id={field.id} name={field.name} required><option value="">— Select —</option>{field.options.map(option=><option value={option}>{option}</option>)}</select></div>)}
      <div class="mail-field"><label for="mail-email">Email</label><input id="mail-email" name="Email" type="email" autocomplete="email" required/></div>
      <div class="mail-field"><label for="mail-date">Event Date</label><input id="mail-date" name="Event Date" type="date" required/></div>
      <div class="mail-field mail-field-wide"><label for="mail-address">Venue Address</label><textarea id="mail-address" name="Venue Address" rows="3" required></textarea></div>
     </div>
     <button type="submit" class="inquiry-submit" aria-describedby="mail-form-help">Prepare email inquiry <svg class="inline-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10"/></svg></button>
     <noscript><p>Your email app will open with your selections. If it does not open, email <a href="mailto:hello@photopartycity.com">hello@photopartycity.com</a> or call <a href="tel:+19094037143">(909) 403-7143</a>.</p></noscript>
    </form>
   </section>

   <section aria-labelledby="mail-states-title">
    <div class="widget widget-heading"><h2 id="mail-states-title">States We Proudly Serve</h2></div>
    <div class="widget widget-text-editor"><p>Tell us your venue address when booking so we can confirm delivery for your event.</p></div>
   <iframe class="mail-map" title="Map of the United States for photo booth by mail delivery" width="1000" height="380" loading="lazy" referrerpolicy="no-referrer-when-downgrade" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d18696299.842840057!2d-109.31061126403752!3d39.03254337586955!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x54eab584e432360b%3A0x1c3bb99243deb742!2sUnited%20States!5e1!3m2!1sen!2s!4v1693918072161!5m2!1sen!2s"></iframe>
   </section>

   <section aria-labelledby="mail-faq-title">
    <div class="widget widget-heading"><h2 id="mail-faq-title">Frequently Asked Questions</h2></div>
    {mail.faqs.map(faq=><details class="faq"><summary>{faq.question}</summary><div set:html={faq.answer}/></details>)}
   </section>
  </div>
 </div>
 <section slot="closing" class="closing"><p class="eyebrow">THE PARTY STARTS WITH A BOX</p><h2>Make your next celebration one to remember.</h2><p>Photo Booth By Mail · $275 base rental · Free shipping included</p><a class="book-button" href={mail.booking}>Book your booth by mail <svg class="inline-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10"/></svg></a><a class="text-link" href="tel:+19094037143">Or call (909) 403-7143</a></section>
</Layout>
