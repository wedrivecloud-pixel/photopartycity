---
import RentalLayout from '../layouts/RentalLayout.astro';
import FAQ from '../components/redesign/FAQ.astro';
import {bookingLinks,addons,mailRental,mailTerms,money,serviceSchema} from '../data/rentals';
const title = "Photo Booth By Mail - Photo Party City";
const description = "Photo Booth By Mail delivers the fun to your door. Rentals from $275 with free shipping, easy setup, digital sharing, and optional prints.";
const canonical = "https://photopartycity.com/photo-booth-by-mail/";
const faqs = [
  {question:"When does the booth arrive?",answer:`1–2 days before your event. For a Saturday party, expect it Thursday or Friday.`},
  {question:"When do I send it back?",answer:`Drop it at UPS on the first business day after your event — Monday for weekend parties. Late returns are ${money(mailTerms.lateReturnPerDay)} per day, per item.`},
  {question:"What if I cancel?",answer:`Full refund if you cancel more than 7 days before your event. Within 7 days, there’s a ${money(mailTerms.cancellationFee)} fee.`},
  {question:"What if something goes wrong?",answer:`Call or text (909) 403-7143. Contact our team for help, and confirm event-day support arrangements when you book.`},
  {question:"Do I need Wi‑Fi?",answer:`Yes, for texting and emailing photos. No Wi‑Fi? Add a hotspot for ${money(addons.mailHotspot)}.`},
  {question:"How do guests get their photos?",answer:`By text or email on the spot, or as prints if you add a print package.`},
];
const schema = serviceSchema("Photo Booth By Mail",canonical,[mailRental]);
---
<RentalLayout title={title} description={description} canonical={canonical} image="/media/by-mail/helio-booth.webp" schema={schema} breadcrumbs={[{name:'Home',href:'/'},{name:'Ways to rent',href:'/photo-booth-packages/'},{name:"Photo booth by mail"}]} checkHref={bookingLinks.mail}>


<!-- Hero -->
<section style="padding-block: 24px clamp(56px, 7vw, 96px)">
<div class="ppc-wrap ppc-hero">
<div class="ppc-stack" style="gap: 22px">
<span class="ppc-tag ppc-tag-blue">We ship it · Anywhere in the continental US</span>
<h1 class="ppc-h1">A photo booth, shipped to your door.</h1>
<p class="ppc-lead">It arrives 1–2 days before your party, includes a setup guide, and goes back with a prepaid label. Shipping is free both ways.</p>
<div class="ppc-row">
<p class="ppc-price"><span>from</span><b>{money(mailRental.price)}</b></p>
<a class="ppc-btnp" href={bookingLinks.mail} data-source="hero" data-booth="mail">Check your date</a>
<a class="ppc-link" href="tel:+19094037143" data-source="hero" data-booth="mail">Call or text (909) 403-7143</a>
</div>
<ul class="ppc-checks ppc-checks-row"><li>Free shipping both ways</li><li>Guided setup</li><li>Setup guide included</li></ul>
</div>
<div style="position: relative">
<div class="ppc-ph t-sky ppc-r45" style="border-radius: 28px"><span>Photo: friends laughing at a house party, booth in the corner</span></div>
<div class="ppc-hidesm ppc-row" style="position: absolute; right: -20px; bottom: 40px; align-items: center; gap: 12px; padding: 14px 18px; border-radius: 18px; background: #FFFFFF; box-shadow: 0 20px 40px -16px rgba(31, 26, 36, 0.3)">
<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#54228b" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7.5L12 3l9 4.5v9L12 21l-9-4.5z"></path><path d="M3 7.5L12 12l9-4.5M12 12v9"></path></svg>
<span style="display: flex; flex-direction: column; line-height: 1.3"><strong style="font-size: 15px">Arrives 1–2 days early</strong><span style="font-size: 13px; color: #5C5463">Saturday party → Thursday or Friday</span></span>
</div>
</div>
</div>
</section>

<!-- How it works -->
<section id="how" class="ppc-section ppc-band" aria-labelledby="how-h">
<div class="ppc-wrap ppc-stack-lg">
<h2 id="how-h" class="ppc-h2">How booth by mail works</h2>
<ol class="ppc-numcards ppc-grid4">
<li class="ppc-card ppc-stack" style="gap: 12px"><div class="ppc-ph t-lav ppc-r43" style="order: -1"><span>Photo: host booking on her phone</span></div><h3 class="ppc-h3" style="font-size: 21px">Check your date</h3><p class="ppc-p" style="font-size: 16px">Pick your date and options, then book online.</p></li>
<li class="ppc-card ppc-stack" style="gap: 12px"><div class="ppc-ph t-blush ppc-r43" style="order: -1"><span>Image: a print layout with names and date</span></div><h3 class="ppc-h3" style="font-size: 21px">Design your print layout</h3><p class="ppc-p" style="font-size: 16px">Choose a template and add your names, date or logo.</p></li>
<li class="ppc-card ppc-stack" style="gap: 12px"><div class="ppc-ph t-gold ppc-r43" style="order: -1"><span>Photo: case arriving at a front door</span></div><h3 class="ppc-h3" style="font-size: 21px">It arrives before your event</h3><p class="ppc-p" style="font-size: 16px">Follow the setup guide and test the booth before your guests arrive.</p></li>
<li class="ppc-card ppc-stack" style="gap: 12px"><div class="ppc-ph t-sage ppc-r43" style="order: -1"><span>Photo: case dropped off at a UPS counter</span></div><h3 class="ppc-h3" style="font-size: 21px">Ship it back</h3><p class="ppc-p" style="font-size: 16px">Pack the case, attach the prepaid label and drop it at UPS the next business day.</p></li>
</ol>
</div>
</section>

<!-- In the box -->
<section class="ppc-section" aria-labelledby="box-h">
<div class="ppc-wrap ppc-split">
<div class="ppc-ph ppc-r43"><span>Photo: the open travel case with booth, light and props</span></div>
<div class="ppc-stack" style="gap: 18px">
<h2 id="box-h" class="ppc-h2">What’s in the box</h2>
<ul class="ppc-checks" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr)); gap: 10px 24px">
<li>Helio photo booth</li><li>Camera, stand and light</li><li>Backdrop with stand</li><li>Props for your guests</li><li>All‑night use</li><li>Prepaid return label</li>
</ul>
<p class="ppc-small">Add your logo to the photo layout when you book.</p>
</div>
</div>
</section>

<!-- Sharing -->
<section class="ppc-section ppc-white" aria-labelledby="share-h">
<div class="ppc-wrap ppc-split">
<div class="ppc-stack" style="gap: 18px">
<h2 id="share-h" class="ppc-h2">Photos on every guest’s phone, instantly</h2>
<p class="ppc-p">Guests text, email or AirDrop their photos straight from the booth. You get the complete event album afterward.</p>
<ul class="ppc-checks"><li>Text, email and AirDrop sharing</li><li>Complete event photo album</li><li>No Wi‑Fi at the venue? Add a hotspot for {money(addons.mailHotspot)}</li></ul>
</div>
<div class="ppc-grid2" style="gap: 12px">
<div class="ppc-ph t-lil ppc-r45"><span>Photo: guests laughing at a photo on a phone</span></div>
<div class="ppc-ph t-blush ppc-r45" style="margin-top: 40px"><span>Photo: group squeezed into one shot</span></div>
</div>
</div>
</section>

<!-- Options -->
<section class="ppc-section" aria-labelledby="opt-h">
<div class="ppc-wrap ppc-stack-lg">
<div class="ppc-stack" style="gap: 12px">
<h2 id="opt-h" class="ppc-h2">Make it yours</h2>
<p class="ppc-p">Choose these when you book. Add-on prices and availability are confirmed in your proposal.</p>
</div>
<div class="ppc-grid4">
<div class="ppc-card ppc-stack" style="gap: 8px"><h3 class="ppc-h4">Prints</h3><p class="ppc-p" style="font-size: 16px">On-site packages of 54, 108, 162 or 216 prints, or after-event prints shipped after the booth is returned. Pricing is confirmed in your proposal.</p></div>
<div class="ppc-card ppc-stack" style="gap: 8px"><h3 class="ppc-h4">Backdrop</h3><p class="ppc-p" style="font-size: 16px">Pick a backdrop, or just the stand for one you already have.</p></div>
<div class="ppc-card ppc-stack" style="gap: 8px"><h3 class="ppc-h4">Props</h3><p class="ppc-p" style="font-size: 16px">55+ themed prop sets — birthdays, weddings, holidays and more. <a href="/photobooth-props/" style="font-weight: 600">Browse props</a></p></div>
<div class="ppc-card ppc-stack" style="gap: 8px"><h3 class="ppc-h4">Damage protection</h3><p class="ppc-p" style="font-size: 16px">Optional accidental damage coverage. Price and coverage are confirmed in your proposal.</p></div>
</div>
</div>
</section>

<!-- Coverage -->
<section class="ppc-section ppc-band" aria-labelledby="where-h">
<div class="ppc-wrap ppc-area">
<div class="ppc-stack" style="gap: 18px">
<h2 id="where-h" class="ppc-h2">We ship anywhere in the continental US</h2>
<p class="ppc-p">All 48 contiguous states. We confirm delivery timing for your address when you book.</p>
<p class="ppc-callout" style="margin: 0"><strong>Within 45 miles of Mira Loma?</strong> <a href="/full-service-photo-booth-rental/" style="font-weight: 600">We can deliver it and run it for you.</a></p>
</div>
<div class="ppc-ph t-sky ppc-r169" style="background: #DDE6EF"><span>Map: continental US, shaded</span></div>
</div>
</section>

<!-- FAQ -->
<section class="ppc-section" aria-labelledby="faq-h">
<div class="ppc-wrap ppc-faqgrid">
<div class="ppc-stack"><h2 id="faq-h" class="ppc-h2">Booth by mail questions</h2><p class="ppc-p">Something else? <a href="tel:+19094037143" style="font-weight: 600" data-source="section" data-booth="mail">Call or text (909) 403-7143</a>.</p></div>
<FAQ items={faqs} bare />
</div>
</section>

</RentalLayout>
