---
import RentalLayout from '../layouts/RentalLayout.astro';
import Photo from '../components/redesign/Photo.astro';
import pages from '../data/pages.json';
const posts=pages.filter(page=>page.type==='post');
const featured=posts.find(page=>page.slug==='photobooth-event-benefits')!;
const eventPosts=posts.filter(page=>page.slug!==featured.slug && !['unlocking-success','how-to-build-a-profitable-photo-booth-business'].includes(page.slug));
const ownerPosts=posts.filter(page=>['unlocking-success','how-to-build-a-profitable-photo-booth-business'].includes(page.slug));
const postName=(slug:string,name:string)=>slug==='2-photo-booth-rental-packages-you-can-get-right-now' ? '5 types of photo booths: find your event’s fit.' : name;
const postHref=(slug:string,path:string)=>slug==='2-photo-booth-rental-packages-you-can-get-right-now' ? '/types-of-photo-booths/' : path;
---
<RentalLayout title="Photo Booth Ideas & Event Planning | Photo Party City" description="Explore Photo Party City's photo booth ideas, event planning guides, and advice for celebrations and photo booth businesses." breadcrumbs={[{name:'Home',href:'/'},{name:'Blog'}]} ctaHeading="Let’s turn a good idea into a great event.">
  <header class="ppc-section-sm"><div class="ppc-wrap ppc-stack"><p class="ppc-eyebrow">The Photo Party City blog</p><h1 class="ppc-h1">Ideas for your next great event.</h1><p class="ppc-lead">Helpful reads for choosing your booth, planning the details and making room for a little more fun.</p><div class="ppc-row"><a class="ppc-btnp" href="/check-your-date/">Check your date</a><a class="ppc-link" href="tel:+19094037143">Call or text (909) 403-7143</a></div></div></header>
  <section class="ppc-section-sm"><div class="ppc-wrap"><article class="ppc-featured-post"><figure class="ppc-editorial-figure"><Photo label="Guests laughing with props and holding their event photo strips" src="/media/blog/featured.webp" alt="Illustrative scene of three friends laughing with printed photo strips, a heart prop and a star prop" width={1200} height={900} loading="eager" fetchpriority="high" ratio="4/3" tone="blush"/><figcaption class="ppc-small">AI-generated illustrative event imagery.</figcaption></figure><div class="ppc-stack"><span class="ppc-tag">Featured article</span><h2 class="ppc-h2"><a href={featured.path}>5 reasons to bring a photo booth to your event.</a></h2><p class="ppc-p">A shared activity, a printed keepsake, a reason to gather your favorite people. Explore what a photo booth can add to your celebration.</p><a class="ppc-link" href={featured.path}>Read the article →</a></div></article></div></section>
  <section class="ppc-section ppc-white"><div class="ppc-wrap ppc-stack-lg"><div class="ppc-stack"><p class="ppc-eyebrow">For your celebration</p><h2 class="ppc-h2">Find your photo booth style.</h2></div><div class="ppc-grid2">{eventPosts.map(post=><article class="ppc-card ppc-stack"><figure class="ppc-editorial-figure"><Photo label="Friends taking a group photo in an open-air booth" src="/media/blog/types.webp" alt="Illustrative scene of two friends posing in front of an open-air ring-light photo booth at a party" width={1280} height={720} loading="lazy" ratio="16/9" tone="sage"/><figcaption class="ppc-small">AI-generated illustrative event imagery.</figcaption></figure><h3 class="ppc-h3"><a href={postHref(post.slug,post.path)}>{postName(post.slug,post.name)}</a></h3><p class="ppc-p">{post.description}</p><a class="ppc-link" href={postHref(post.slug,post.path)}>Read the article →</a></article>)}<aside class="ppc-card ppc-stack"><p class="ppc-eyebrow">Put the plans in motion</p><h3 class="ppc-h3">Which rental fits your event?</h3><p class="ppc-p">Have an attendant take care of the booth, pick one up for the day, or have it delivered by mail. Start with the experience, then choose the equipment and extras.</p><a class="ppc-link" href="/photo-booth-packages/">Compare photo booth packages →</a><a class="ppc-link" href="/photo-booth-rental-cost/">Read the rental cost guide →</a></aside></div></div></section>
  <section class="ppc-section"><div class="ppc-wrap ppc-stack-lg"><div class="ppc-stack"><p class="ppc-eyebrow">For booth owners</p><h2 class="ppc-h2">Thinking about the business side?</h2><p class="ppc-p">These existing articles cover running a photo booth business. If you’re renting for your own event, the guides above are a useful place to start.</p></div><div class="ppc-grid2">{ownerPosts.map(post=><article class="ppc-card ppc-stack"><h3 class="ppc-h3"><a href={post.path}>{post.name}</a></h3><p class="ppc-p">{post.description}</p><a class="ppc-link" href={post.path}>Read the article →</a></article>)}</div></div></section>
</RentalLayout>
<style>
 .ppc-featured-post{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:40px;align-items:center;background:#fff;border:1px solid var(--line);border-radius:26px;padding:20px}.ppc-featured-post>div:last-child{padding:16px 16px 16px 0}.ppc-featured-post h2 a,.ppc-card h3 a{color:var(--ink);text-decoration:none}.ppc-featured-post h2 a:hover,.ppc-card h3 a:hover{color:var(--accent)}
 .ppc-editorial-figure{margin:0;min-width:0}.ppc-editorial-figure figcaption{margin-top:8px}
 @media(max-width:960px){.ppc-featured-post{grid-template-columns:minmax(0,1fr);gap:20px}.ppc-featured-post>div:last-child{padding:8px}}
</style>
