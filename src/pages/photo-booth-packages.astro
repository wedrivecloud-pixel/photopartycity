---
import RentalLayout from '../layouts/RentalLayout.astro';
import FAQ from '../components/redesign/FAQ.astro';
import {fullServiceTiers,selfServiceTiers,bookingLinks,addons,booth360Rates,mailRental,money,serviceSchema} from '../data/rentals';
const title = "Photo Booth Rental Packages & Pricing | Photo Party City";
const description = "Compare full-service and self-service photo booth rental packages. Find the right fit for your event and request a booking today.";
const canonical = "https://photopartycity.com/photo-booth-packages/";
const faqs = [
  {question:"What’s the difference between full service and self‑service?",answer:`Full service includes delivery, setup, an attendant and unlimited prints for 3–5 hours. Self‑service is a 24‑hour rental you pick up and run yourself; prints are an add‑on.`},
  {question:"Can you deliver a self‑service booth?",answer:`Yes. Delivery, setup and pickup are available for an added charge that depends on your address. It’s shown in your proposal before you book.`},
  {question:"Which areas do you serve?",answer:`Staffed and pickup rentals cover 45 miles around Mira Loma. Photo Booth By Mail ships anywhere in the continental US.`},
  {question:"Is Gold just Silver with an extra hour?",answer:`No. Gold uses the Lumia M Pro with a DSLR camera. Adding hours to Silver keeps the Helio Sport booth.`},
  {question:"Does checking my date reserve it?",answer:`Not yet. We confirm availability and send a proposal; your date is reserved once you approve it and book.`},
];
const schema = serviceSchema("Packages photo booth rental",canonical,[...fullServiceTiers,...selfServiceTiers,mailRental]);
---
<RentalLayout title={title} description={description} canonical={canonical} image="/media/f69b4b7237d721ff.webp" schema={schema} breadcrumbs={[{name:'Home',href:'/'},{name:"Packages"}]} checkHref={bookingLinks.general}>


<!-- Hero -->
<section style="padding-block: 24px clamp(40px, 5vw, 64px)">
<div class="ppc-wrap ppc-stack" style="gap: 20px">
<h1 class="ppc-h1" style="max-width: 16ch">Photo booth packages, priced up front.</h1>
<p class="ppc-lead">Staffed or self-service near Mira Loma, or shipped anywhere in the US. Every price on this page is the starting price; your proposal confirms the total.</p>
<div class="ppc-row"><a class="ppc-btnp" href={bookingLinks.general} data-source="hero" data-booth="general">Check your date</a><a class="ppc-link" href="tel:+19094037143" data-source="hero" data-booth="general">Call or text (909) 403-7143</a></div>
<ul class="ppc-chips" aria-label="Jump to">
<li style="padding: 0; background: none"><a href="#full">We bring it — full service</a></li>
<li style="padding: 0; background: none"><a href="#self">You pick it up — self-service</a></li>
<li style="padding: 0; background: none"><a href="#ship">We ship it — nationwide</a></li>
<li style="padding: 0; background: none"><a href="#v360">360 video</a></li>
</ul>
</div>
</section>

<!-- Full service -->
<section id="fullservice" class="ppc-section" style="padding-top: 0">
<span id="full" aria-hidden="true"></span>
<div class="ppc-wrap ppc-stack-lg">
<div class="ppc-stack" style="gap: 12px">
<span class="ppc-tag">Within 45 mi of Mira Loma</span>
<h2 class="ppc-h2">We bring it: full service with prints</h2>
<p class="ppc-p">We deliver, set up and run the booth with an attendant. Packages differ by hours and booth model.</p>
</div>
<div class="ppc-cards">
<article class="ppc-tier">
<div class="ppc-ph t-lav ppc-r32"><span>Photo: guests laughing at the Helio Sport booth</span></div>
<div class="ppc-tier-body">
<p class="ppc-eyebrow">3 hours · Helio Sport</p>
<h3 class="ppc-h3" style="font-size: 28px">{fullServiceTiers[0].name}</h3>
<ul class="ppc-checks"><li>iPad camera booth</li><li>Attendant on site</li><li>Unlimited prints</li></ul>
</div>
<div class="ppc-tier-foot">
<p class="ppc-price"><span>from</span><b>{money(fullServiceTiers[0].price)}</b></p>
<a class="ppc-btng ppc-btn-sm" href={fullServiceTiers[0].href} data-source="card" data-booth="full">Check your date</a>
</div>
</article>
<article class="ppc-tier is-feature">
<span class="ppc-badge">Most popular</span>
<div class="ppc-ph t-blush ppc-r32"><span>Photo: wedding guests at the Lumia M Pro</span></div>
<div class="ppc-tier-body">
<p class="ppc-eyebrow">4 hours · Lumia M Pro</p>
<h3 class="ppc-h3" style="font-size: 28px">{fullServiceTiers[1].name}</h3>
<ul class="ppc-checks"><li>iPad + DSLR camera</li><li>Attendant on site</li><li>Unlimited prints</li></ul>
</div>
<div class="ppc-tier-foot">
<p class="ppc-price"><span>from</span><b>{money(fullServiceTiers[1].price)}</b></p>
<a class="ppc-btnp ppc-btn-sm" href={fullServiceTiers[1].href} data-source="card" data-booth="full">Check your date</a>
</div>
</article>
<article class="ppc-tier">
<div class="ppc-ph t-gold ppc-r32"><span>Photo: party crowd around the Posh Pro display</span></div>
<div class="ppc-tier-body">
<p class="ppc-eyebrow">5 hours · Posh Pro</p>
<h3 class="ppc-h3" style="font-size: 28px">{fullServiceTiers[2].name}</h3>
<ul class="ppc-checks"><li>iPad + DSLR camera</li><li>37‑inch display for slideshows or branding</li><li>Attendant and unlimited prints</li></ul>
</div>
<div class="ppc-tier-foot">
<p class="ppc-price"><span>from</span><b>{money(fullServiceTiers[2].price)}</b></p>
<a class="ppc-btng ppc-btn-sm" href={fullServiceTiers[2].href} data-source="card" data-booth="full">Check your date</a>
</div>
</article>
</div>
<div class="ppc-card ppc-split ppc-split-top" style="gap: 32px; background: #FFFFFF">
<div class="ppc-stack" style="gap: 8px">
<h3 class="ppc-h3">Included in every full‑service package</h3>
<p class="ppc-small">Need more time? Extra hours are {money(addons.extraHour)} each, subject to availability.</p>
</div>
<ul class="ppc-checks" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr)); gap: 10px 24px">
<li>Delivery, setup and takedown</li><li>On‑site attendant</li><li>Unlimited prints</li><li>Personalized photo design</li><li>Backdrop from our collection</li><li>Guest props</li><li>Digital copies of every print</li><li>30‑day online gallery</li>
</ul>
</div>
</div>
</section>

<!-- Self-service -->
<section id="selfservice" class="ppc-section ppc-band">
<span id="self" aria-hidden="true"></span>
<div class="ppc-wrap ppc-stack-lg">
<div class="ppc-stack" style="gap: 12px">
<span class="ppc-tag">Within 45 mi of Mira Loma</span>
<h2 class="ppc-h2">You pick it up: 24‑hour self‑service</h2>
<p class="ppc-p">Pick up in Mira Loma, run it yourself for a full day, bring it back. Digital photos, GIFs and boomerangs are unlimited; prints are an add‑on.</p>
</div>
<div class="ppc-cards">
<article class="ppc-tier">
<div class="ppc-ph t-sage ppc-r32"><span>Photo: friends at a backyard birthday</span></div>
<div class="ppc-tier-body">
<p class="ppc-eyebrow">24 hours · Helio Sport</p>
<h3 class="ppc-h3" style="font-size: 28px">{selfServiceTiers[0].name}</h3>
<ul class="ppc-checks"><li>Built‑in iPad camera</li><li>Unlimited digital photos and sharing</li><li>Videos, GIFs and boomerangs</li></ul>
</div>
<div class="ppc-tier-foot">
<p class="ppc-price"><span>from</span><b>{money(selfServiceTiers[0].price)}</b><span>/ day</span></p>
<a class="ppc-btnp ppc-btn-sm" href={selfServiceTiers[0].href} data-source="card" data-booth="self">Check your date</a>
</div>
</article>
<article class="ppc-tier">
<div class="ppc-ph t-lil ppc-r32"><span>Photo: graduates posing with props</span></div>
<div class="ppc-tier-body">
<p class="ppc-eyebrow">24 hours · Lumia M Pro</p>
<h3 class="ppc-h3" style="font-size: 28px">{selfServiceTiers[1].name}</h3>
<ul class="ppc-checks"><li>iPad + DSLR camera</li><li>Unlimited digital photos and sharing</li><li>Optional prints</li></ul>
</div>
<div class="ppc-tier-foot">
<p class="ppc-price"><span>from</span><b>{money(selfServiceTiers[1].price)}</b><span>/ day</span></p>
<a class="ppc-btng ppc-btn-sm" href={selfServiceTiers[1].href} data-source="card" data-booth="self">Check your date</a>
</div>
</article>
<article class="ppc-tier">
<div class="ppc-ph t-sky ppc-r32"><span>Photo: coworkers at a branded company party</span></div>
<div class="ppc-tier-body">
<p class="ppc-eyebrow">24 hours · Posh Pro</p>
<h3 class="ppc-h3" style="font-size: 28px">{selfServiceTiers[2].name}</h3>
<ul class="ppc-checks"><li>iPad + DSLR camera</li><li>37‑inch signage column</li><li>Optional prints</li></ul>
</div>
<div class="ppc-tier-foot">
<p class="ppc-price"><span>from</span><b>{money(selfServiceTiers[2].price)}</b><span>/ day</span></p>
<a class="ppc-btng ppc-btn-sm" href={selfServiceTiers[2].href} data-source="card" data-booth="self">Check your date</a>
</div>
</article>
</div>
<div class="ppc-grid2" style="align-items: start">
<div class="ppc-card ppc-stack" style="gap: 14px">
<h3 class="ppc-h3">Included in every self‑service rental</h3>
<ul class="ppc-checks"><li>Custom digital backdrop</li><li>100+ premade templates</li><li>Unlimited videos, boomerangs and GIFs</li><li>Unlimited digital photos and social sharing</li><li>Digital album access</li></ul>
</div>
<div class="ppc-card ppc-stack" style="gap: 14px">
<h3 class="ppc-h3">Add‑ons</h3>
<table class="ppc-table" style="min-width: 0">
<tbody>
<tr><th scope="row">Printer</th><td class="num">{money(addons.printer)}</td></tr>
<tr><th scope="row">Media kit (100 4×6 prints)</th><td class="num">{money(addons.mediaKit)}</td></tr>
<tr><th scope="row">Custom template design</th><td class="num">{money(addons.customTemplate)}</td></tr>
<tr><th scope="row">Physical backdrop</th><td class="num">{money(addons.backdrop)}</td></tr>
<tr><th scope="row">Delivery, setup and pickup</th><td>Quoted in your proposal</td></tr>
</tbody>
</table>
</div>
</div>
</div>
</section>

<!-- Ship -->
<section id="ship" class="ppc-section">
<div class="ppc-wrap">
<div class="ppc-card ppc-split" style="padding: clamp(20px, 3vw, 40px); border: 2px solid var(--accent); gap: 40px">
<div class="ppc-ph t-sky ppc-r43"><span>Photo: family laughing at a living‑room party</span></div>
<div class="ppc-stack" style="gap: 16px">
<span class="ppc-tag ppc-tag-blue">Anywhere in the continental US</span>
<h2 class="ppc-h2">We ship it: Photo Booth By Mail</h2>
<p class="ppc-p">The booth arrives 1–2 days before your event in one padded case. Follow the included setup guide, party all night, then send it back with the prepaid label.</p>
<ul class="ppc-checks"><li>Free shipping both ways</li><li>Helio booth, light, stand, backdrop and props</li><li>Photos texted and emailed instantly</li><li>Optional print packages</li></ul>
<div class="ppc-row" style="margin-top: 8px">
<p class="ppc-price"><span>from</span><b>{money(mailRental.price)}</b></p>
<a class="ppc-btnp" href={bookingLinks.mail} data-source="section" data-booth="mail">Check your date</a>
<a class="ppc-link" href="/photo-booth-by-mail/">How shipping works</a>
</div>
</div>
</div>
</div>
</section>

<!-- 360 -->
<section id="v360" class="ppc-section ppc-white">
<div class="ppc-wrap ppc-split ppc-split-top">
<div class="ppc-stack" style="gap: 16px">
<span class="ppc-tag">Within 45 mi of Mira Loma</span>
<h2 class="ppc-h2">360 video booth</h2>
<p class="ppc-p">Guests step on the platform and the camera arm circles them for a slow‑motion video they can share on the spot. Every rental includes a custom template.</p>
<div class="ppc-row">
<a class="ppc-btnp" href={bookingLinks.booth360} data-source="section" data-booth="360">Check your date</a>
<a class="ppc-link" href="/360-photo-booth-rental/">More about 360</a>
</div>
</div>
<div class="ppc-tablebox">
<table class="ppc-table" style="min-width: 420px">
<thead><tr><th scope="col">Booth time</th><th scope="col">Full service<br><span style="text-transform: none; letter-spacing: 0; font-weight: 500">we set it up</span></th><th scope="col">Self‑service<br><span style="text-transform: none; letter-spacing: 0; font-weight: 500">you run it</span></th></tr></thead>
<tbody>
<tr><th scope="row">2 hours</th><td class="num">{money(booth360Rates.full[2])}</td><td class="num">{money(booth360Rates.self[2])}</td></tr>
<tr><th scope="row">3 hours</th><td class="num">{money(booth360Rates.full[3])}</td><td class="num">{money(booth360Rates.self[3])}</td></tr>
<tr><th scope="row">4 hours</th><td class="num">{money(booth360Rates.full[4])}</td><td class="num">{money(booth360Rates.self[4])}</td></tr>
</tbody>
</table>
</div>
</div>
</section>

<!-- Compare -->
<section class="ppc-section" aria-labelledby="cmp-h">
<div class="ppc-wrap ppc-stack-lg">
<h2 id="cmp-h" class="ppc-h2">Which way fits your party?</h2>
<div class="ppc-tablebox">
<table class="ppc-table">
<thead><tr><th scope="col"></th><th scope="col">We bring it</th><th scope="col">You pick it up</th><th scope="col">We ship it</th></tr></thead>
<tbody>
<tr><th scope="row">Where</th><td>Within 45 mi of Mira Loma</td><td>Pickup in Mira Loma</td><td>Anywhere in the continental US</td></tr>
<tr><th scope="row">Who runs it</th><td>Our attendant</td><td>You or a helper</td><td>You — Guided setup</td></tr>
<tr><th scope="row">Booth time</th><td>3, 4 or 5 hours</td><td>24 hours</td><td>All night, return next business day</td></tr>
<tr><th scope="row">Prints</th><td>Unlimited, included</td><td>Add‑on</td><td>Optional print packages</td></tr>
<tr><th scope="row">Best for</th><td>Weddings, big parties, corporate</td><td>Birthdays, showers, open houses</td><td>Out‑of‑area parties of any size</td></tr>
</tbody>
</table>
</div>
</div>
</section>

<!-- Booths -->
<section id="ata-photobooths-packages" class="ppc-section ppc-band" aria-labelledby="models-h">
<div class="ppc-wrap ppc-stack-lg">
<div class="ppc-stack" style="gap: 12px">
<h2 id="models-h" class="ppc-h2">Booths made by ATA Photobooths</h2>
<p class="ppc-p">Each booth comes in a full‑service and a self‑service version.</p>
</div>
<div class="ppc-grid3">
<div class="ppc-card ppc-stack" style="gap: 12px"><div class="ppc-ph t-lav ppc-r43"><span>Photo: Helio Sport at a party</span></div><h3 class="ppc-h3">Helio Sport</h3><p class="ppc-small">Silver · Starter — iPad camera</p><a class="ppc-link" href="https://www.ataphotobooths.com/shop/helio-sport-ipad-photobooth-system-package/" style="font-size: 15px">Booth specs</a></div>
<div class="ppc-card ppc-stack" style="gap: 12px"><div class="ppc-ph t-blush ppc-r43"><span>Photo: Lumia M Pro at a wedding</span></div><h3 class="ppc-h3">Lumia M Pro</h3><p class="ppc-small">Gold · Showbiz — iPad + DSLR</p><a class="ppc-link" href="https://www.ataphotobooths.com/shop/lumia-m-pro-ipad-based-full-system-package/" style="font-size: 15px">Booth specs</a></div>
<div class="ppc-card ppc-stack" style="gap: 12px"><div class="ppc-ph t-gold ppc-r43"><span>Photo: Posh Pro at a company event</span></div><h3 class="ppc-h3">Posh Pro</h3><p class="ppc-small">Platinum · Hollywood — iPad + DSLR + 37‑inch display</p><a class="ppc-link" href="https://www.ataphotobooths.com/shop/helio-sapphire-pro-m50-ipad-photobooth-system-package/" style="font-size: 15px">Booth specs</a></div>
</div>
</div>
</section>

<!-- FAQ -->
<section class="ppc-section" aria-labelledby="faq-h">
<div class="ppc-wrap ppc-faqgrid">
<div class="ppc-stack">
<h2 id="faq-h" class="ppc-h2">Package questions</h2>
<p class="ppc-p">Something else? <a href="tel:+19094037143" style="font-weight: 600" data-source="section" data-booth="general">Call or text (909) 403-7143</a>.</p>
</div>
<FAQ items={faqs} bare />
</div>
</section>

<section id="rental-planning-links" class="ppc-section-sm ppc-band"><div class="ppc-wrap ppc-stack"><h2 class="ppc-h3">Plan your photo booth rental</h2><div class="ppc-row"><a class="ppc-link" href="/photo-booth-rental-cost/">Rental cost guide</a><a class="ppc-link" href="/wedding-photo-booth-rental/">Wedding rentals</a><a class="ppc-link" href="/corporate-photo-booth-rental/">Corporate rentals</a><a class="ppc-link" href="/contact-us/">Talk to our team</a></div></div></section>

</RentalLayout>
