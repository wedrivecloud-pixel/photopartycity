---
import RentalLayout from '../layouts/RentalLayout.astro';
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY as string | undefined;
---
<RentalLayout title="Contact Photo Party City | Photo booth rentals" description="Call or text Photo Party City at (909) 403-7143. Visit our Mira Loma pickup location or ask about local and shipped photo booth rentals." breadcrumbs={[{name:'Home',href:'/'},{name:'Contact'}]}>
  <section class="ppc-section contact-hero" data-source="contact">
    <div class="ppc-wrap">
      <div class="contact-intro ppc-stack"><p class="ppc-eyebrow">A real person, a good plan</p><h1 class="ppc-h1">Let’s talk about your event.</h1><p class="ppc-p">Need help choosing a booth, planning pickup, or arranging shipping? We’re here to help.</p></div>
      <div class="contact-cards">
        <div class="ppc-card contact-card"><span class="contact-icon" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M7 3H4a1 1 0 0 0-1 1c0 9.4 7.6 17 17 17a1 1 0 0 0 1-1v-3l-5-2-2 2a14 14 0 0 1-7-7l2-2-2-5Z"/></svg></span><h2 class="ppc-h3">Call or text</h2><a href="tel:+19094037143" data-source="contact-card">(909) 403-7143</a><a href="sms:+19094037143" data-source="contact-card">Send a text →</a><p>Mon–Fri, 9 AM–5 PM Pacific</p></div>
        <div class="ppc-card contact-card"><span class="contact-icon" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 6 9 7 9-7"/></svg></span><h2 class="ppc-h3">Email us</h2><a class="contact-email" href="mailto:hello@photopartycity.com">hello@photopartycity.com</a><p>Tell us your date, location, and what you have in mind.</p></div>
        <div class="ppc-card contact-card"><span class="contact-icon" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M19 10c0 5-7 11-7 11S5 15 5 10a7 7 0 1 1 14 0Z"/><circle cx="12" cy="10" r="2.3"/></svg></span><h2 class="ppc-h3">Find us in Mira Loma</h2><p>3827 Wacker Dr.<br />Mira Loma, CA 91752</p><a href="https://www.google.com/maps/search/?api=1&query=3827+Wacker+Dr+Mira+Loma+CA+91752" rel="external">Get directions →</a></div>
      </div>
    </div>
  </section>
  <section class="ppc-section contact-form-section" aria-labelledby="contact-form-heading">
    <div class="ppc-wrap contact-form-grid">
      <div class="ppc-stack contact-form-copy"><p class="ppc-eyebrow">We’ll help you figure it out</p><h2 class="ppc-h2" id="contact-form-heading">A few details go a long way.</h2><p class="ppc-p">Tell us about your celebration and the kind of booth you’re considering.</p><p>Already know your date? <a href="/check-your-date/">See your rental options →</a></p><p class="contact-hours">Our hours are Monday–Friday, 9 AM–5 PM Pacific. For a quick answer, call or text <a href="tel:+19094037143">(909) 403-7143</a>.</p></div>
      <form class="ppc-card contact-form" id="contact-message-form" action="/api/contact" method="post" data-source="contact-form">
        <div class="contact-fields"><div><label for="contact-name">Your name</label><input class="ppc-input" id="contact-name" name="name" autocomplete="name" maxlength="100" required /></div><div><label for="contact-email">Email address</label><input class="ppc-input" id="contact-email" name="email" type="email" autocomplete="email" maxlength="254" required /></div><div><label for="contact-phone">Phone <span>(optional)</span></label><input class="ppc-input" id="contact-phone" name="phone" type="tel" autocomplete="tel" maxlength="40" /></div><div><label for="contact-date">Event date <span>(optional)</span></label><input class="ppc-input" id="contact-date" name="date" type="date" /></div><div class="contact-wide"><label for="contact-zip">Event ZIP <span>(optional)</span></label><input class="ppc-input" id="contact-zip" name="zip" inputmode="numeric" pattern="[0-9]{5}" maxlength="5" autocomplete="postal-code" placeholder="91752" /></div><div class="contact-wide"><label for="contact-message">What are you planning?</label><textarea class="ppc-input" id="contact-message" name="message" rows="5" minlength="10" maxlength="4000" placeholder="Tell us about your event, location, and any questions…" required></textarea></div></div>
        <div class="contact-honeypot" aria-hidden="true"><label for="contact-website">Leave this field empty</label><input id="contact-website" name="website" tabindex="-1" autocomplete="off" /></div>
        {turnstileSiteKey && <div class="cf-turnstile" data-sitekey={turnstileSiteKey}></div>}
        <button class="ppc-btnp" type="submit" id="contact-submit">Send message</button>
        <p class="contact-privacy">We’ll use these details to respond to your inquiry.</p>
        <p class="contact-status" id="contact-status" role="status" aria-live="polite" tabindex="-1"></p>
        <noscript><p>After submitting, the next page will confirm whether your message was sent. You can also <a href="tel:+19094037143">call us</a> or <a href="mailto:hello@photopartycity.com">email hello@photopartycity.com</a>.</p></noscript>
      </form>
    </div>
  </section>
  <section class="ppc-section contact-map-section" aria-labelledby="contact-map-heading"><div class="ppc-wrap"><div class="contact-map-title"><div><p class="ppc-eyebrow">Local roots. Nationwide celebrations.</p><h2 class="ppc-h2" id="contact-map-heading">Stop by Mira Loma.</h2></div><p>3827 Wacker Dr., Mira Loma, CA 91752<br />Mon–Fri, 9 AM–5 PM Pacific</p></div><iframe class="contact-map" title="Photo Party City location at 3827 Wacker Drive, Mira Loma" src="https://maps.google.com/maps?q=3827%20Wacker%20Dr%20Mira%20Loma%20CA%2091752&t=&z=13&ie=UTF8&iwloc=&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe></div></section>
</RentalLayout>
{turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
<script>
  const form = document.querySelector<HTMLFormElement>('#contact-message-form');
  if (form) {
    const button = document.querySelector<HTMLButtonElement>('#contact-submit')!;
    const status = document.querySelector<HTMLElement>('#contact-status')!;
    let pending = false;
    form.addEventListener('submit', async event => {
      event.preventDefault();
      if (pending || !form.reportValidity()) return;
      pending = true; button.disabled = true; button.textContent = 'Sending…'; form.setAttribute('aria-busy', 'true');
      status.textContent = 'Sending your message…'; status.dataset.state = 'pending';
      try {
        const response = await fetch('/api/contact', { method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }, body: JSON.stringify(Object.fromEntries(new FormData(form))), signal: AbortSignal.timeout(15_000) });
        const result = await response.json() as { ok?: boolean; message?: string };
        if (!response.ok || !result.ok) throw new Error(result.message || 'Your message could not be sent. Please call or text (909) 403-7143.');
        status.dataset.state = 'success'; status.textContent = result.message || 'Your message has been sent. Our team will reply to your email.';
        form.reset();
      } catch (error) {
        status.dataset.state = 'error'; status.textContent = error instanceof Error && error.name !== 'TimeoutError' && error.name !== 'TypeError' ? error.message : 'We could not confirm that your message was sent. Please call or text (909) 403-7143, or email hello@photopartycity.com.';
      } finally {
        pending = false; button.disabled = false; button.textContent = 'Send message'; form.removeAttribute('aria-busy'); status.focus({ preventScroll: true });
        const turnstile = (window as Window & { turnstile?: { reset(): void } }).turnstile;
        turnstile?.reset();
      }
    });
  }
</script>
<style>
  .contact-hero{padding-top:48px;padding-bottom:70px}.contact-intro{max-width:780px;margin-bottom:38px}.contact-cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}.contact-card{padding:30px;display:flex;flex-direction:column;align-items:start;gap:12px;min-width:0}.contact-card p{margin:0;color:var(--muted)}.contact-icon{font-size:27px;width:52px;height:52px;background:var(--sand);border-radius:50%;display:grid;place-items:center;color:var(--accent)}.contact-card a{font-weight:600}.contact-email{overflow-wrap:anywhere}.contact-form-section{background:var(--sand)}.contact-form-grid{display:grid;grid-template-columns:.85fr 1.15fr;gap:72px;align-items:start}.contact-form-copy{padding-top:18px}.contact-hours{font-size:15px;color:var(--muted)}.contact-form{padding:34px;background:var(--cream);min-width:0}.contact-fields{display:grid;grid-template-columns:1fr 1fr;gap:20px}.contact-wide{grid-column:1/-1}.contact-form label{font-size:15px;display:block;font-weight:650;margin-bottom:7px}.contact-form label span{font-weight:400;color:var(--muted)}.contact-form .ppc-input{width:100%;min-width:0;min-height:52px}.contact-form textarea{resize:vertical;line-height:1.55}.contact-form button{margin-top:24px}.contact-form button:disabled{opacity:.6;cursor:wait}.contact-privacy{font-size:13px;color:var(--muted);margin-top:15px}.contact-status{line-height:1.5;margin:15px 0 0;outline:none}.contact-status:empty{margin:0}.contact-status[data-state=error]{color:#8b2424}.contact-status[data-state=success]{color:#245c40}.contact-honeypot{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}.contact-map-title{display:flex;justify-content:space-between;align-items:end;gap:30px;margin-bottom:30px}.contact-map-title p{color:var(--muted)}.contact-map{width:100%;height:360px;border:1px solid var(--line);border-radius:24px;display:block}.cf-turnstile{margin-top:20px;max-width:100%;overflow:hidden}
  @media(max-width:960px){.contact-form-grid{grid-template-columns:1fr;gap:32px}.contact-form-copy{max-width:680px}.contact-cards{gap:14px}.contact-card{padding:24px}.contact-map-title{align-items:start;flex-direction:column;gap:16px}}@media(max-width:720px){.contact-cards{grid-template-columns:1fr}.contact-hero{padding-top:30px}.contact-form{padding:24px}.contact-map{height:300px}}@media(max-width:420px){.contact-fields{grid-template-columns:1fr}.contact-wide{grid-column:auto}}
</style>
