---
import RentalLayout from '../layouts/RentalLayout.astro';
import FAQ from '../components/redesign/FAQ.astro';
import Photo from '../components/redesign/Photo.astro';
import {selfServiceTiers,bookingLinks,addons,money,serviceSchema} from '../data/rentals';
const title = "Digital Photo Booth Rental | Inland Empire | From $199";
const description = "Digital photo booth rentals from $199 for 24 hours in the Inland Empire. Capture photos, GIFs, videos, and boomerangs. Compare booths and check your date.";
const canonical = "https://photopartycity.com/digital-photo-booth-rental/";
const faqs = [
  {question:"Will it work without Wi‑Fi?",answer:`The booth still takes photos, but instant sharing needs internet. Tell us if venue Wi‑Fi is unreliable and we’ll plan around it.`},
  {question:"Does digital mean self‑service?",answer:`Yes, for the 24‑hour packages. Full service adds an attendant, prints and a gallery.`},
  {question:"Can I add prints?",answer:`Yes — add a printer and a 100‑print media kit to any package.`},
  {question:"Can the template match my theme?",answer:`Pick from 100+ templates, or add a custom design for ${money(addons.customTemplate)}.`},
  {question:"Does checking my date reserve it?",answer:`Not yet. Your date is reserved once you approve the proposal and book.`},
];
const schema = serviceSchema("Digital booth photo booth rental",canonical,selfServiceTiers);
---
<RentalLayout title={title} description={description} canonical={canonical} image="/media/d59c3c376c573818.webp" schema={schema} breadcrumbs={[{name:'Home',href:'/'},{name:'Ways to rent',href:'/photo-booth-packages/'},{name:"Digital booth"}]} checkHref={bookingLinks.self}>


<section style="padding-block: 24px clamp(56px, 7vw, 96px)">
<div class="ppc-wrap ppc-hero">
<div class="ppc-stack" style="gap: 22px">
<span class="ppc-tag">24 hours · Within 45 mi of Mira Loma</span>
<h1 class="ppc-h1">Digital photo booth rental for the Inland Empire.</h1>
<p class="ppc-lead">Photos, GIFs, videos and boomerangs your guests share on the spot — and a full album for you afterward.</p>
<div class="ppc-row">
<a class="ppc-btnp" href={bookingLinks.self} data-source="hero" data-booth="self">Check your date</a>
<a class="ppc-link" href="tel:+19094037143" data-source="hero" data-booth="self">Call or text (909) 403-7143</a>
</div>
</div>
<div class="digital-hero-art">
<div class="ppc-grid2 digital-hero-photos" style="gap: 12px">
<Photo label="Guests recording a digital booth clip" src="/media/digital/capture.webp" alt="Illustrative scene of adults recording a playful digital photo booth clip" width={1200} height={1500} loading="eager" fetchpriority="high" tone="lil" ratio="4/5"/>
<div style="margin-top: 40px"><Photo label="A guest viewing an event photo" src="/media/digital/phone-sharing.webp" alt="Illustrative scene of a guest viewing an event photo on their phone" width={1200} height={1500} loading="eager" fetchpriority="auto" tone="blush" ratio="4/5"/></div>
</div>
<p class="ppc-small digital-image-caption">Illustrative event imagery.</p>
</div>
</div>
</section>

<section class="ppc-section-sm ppc-white" aria-label="What you get">
<div class="ppc-wrap ppc-grid3">
<div class="ppc-stack" style="gap: 8px"><h2 class="ppc-h3">Every format</h2><p class="ppc-p">Photos, GIFs, short videos and boomerangs — unlimited.</p></div>
<div class="ppc-stack" style="gap: 8px"><h2 class="ppc-h3">Shared on the spot</h2><p class="ppc-p">Guests send their shots to their own phones. Sharing needs internet at the venue.</p></div>
<div class="ppc-stack" style="gap: 8px"><h2 class="ppc-h3">The whole album</h2><p class="ppc-p">You get digital album access to everything taken during your rental.</p></div>
</div>
</section>

<section class="ppc-section" aria-labelledby="pk-h">
<div class="ppc-wrap ppc-stack-lg">
<div class="ppc-stack" style="gap: 12px">
<h2 id="pk-h" class="ppc-h2">Pick your camera</h2>
<p class="ppc-p">All three are 24‑hour self‑service rentals with a custom digital backdrop and 100+ templates.</p>
</div>
<div class="ppc-tablebox">
<table class="ppc-table">
<thead><tr><th scope="col">Package</th><th scope="col">Booth</th><th scope="col">Best for</th><th scope="col">From</th><th scope="col">Book</th></tr></thead>
<tbody>
<tr><th scope="row">{selfServiceTiers[0].name}</th><td>Helio Sport · iPad camera</td><td>Birthdays, showers, family parties</td><td class="num">{money(selfServiceTiers[0].price)} / day</td><td><a class="ppc-btnp ppc-btn-sm" href={selfServiceTiers[0].href} data-source="section" data-booth="self">Check your date</a></td></tr>
<tr><th scope="row">{selfServiceTiers[1].name}</th><td>Lumia M Pro · iPad + DSLR</td><td>Sharper photos for bigger crowds</td><td class="num">{money(selfServiceTiers[1].price)} / day</td><td><a class="ppc-btng ppc-btn-sm" href={selfServiceTiers[1].href} data-source="section" data-booth="self">Check your date</a></td></tr>
<tr><th scope="row">{selfServiceTiers[2].name}</th><td>Posh Pro · iPad + DSLR + 37‑inch display</td><td>Brand content and slideshows</td><td class="num">{money(selfServiceTiers[2].price)} / day</td><td><a class="ppc-btng ppc-btn-sm" href={selfServiceTiers[2].href} data-source="section" data-booth="self">Check your date</a></td></tr>
</tbody>
</table>
</div>
<p class="ppc-small">Pickup and return in Mira Loma. Delivery, prints and a physical backdrop are add‑ons — see <a href="/self-service-photo-booth-rental/" style="font-weight: 600">self‑service details</a>.</p>
</div>
</section>

<section class="ppc-section-sm ppc-band" aria-labelledby="up-h">
<div class="ppc-wrap ppc-split">
<div class="ppc-stack" style="gap: 14px">
<h2 id="up-h" class="ppc-h2">Want prints and someone to run it?</h2>
<p class="ppc-p">Full service adds delivery, an on‑site attendant, unlimited prints and a 30‑day gallery.</p>
<a class="ppc-link" href="/full-service-photo-booth-rental/">See full service</a>
</div>
<div class="digital-upsell-art"><Photo label="Wedding guests with printed photo strips" src="/media/homepage/wedding.webp" alt="Illustrative scene of wedding guests holding printed photo strips" width={1200} height={800} tone="gold" ratio="16/9"/><p class="ppc-small digital-image-caption">Illustrative event imagery.</p></div>
</div>
</section>

<section class="ppc-section" aria-labelledby="faq-h">
<div class="ppc-wrap ppc-faqgrid">
<div class="ppc-stack"><h2 id="faq-h" class="ppc-h2">Digital booth questions</h2><p class="ppc-p">Something else? <a href="tel:+19094037143" style="font-weight: 600" data-source="section" data-booth="self">Call or text (909) 403-7143</a>.</p></div>
<FAQ items={faqs} bare />
</div>
</section>

</RentalLayout>

<style>
 .digital-hero-photos{align-items:start}.digital-hero-photos :global(.ppc-ph){min-height:0;aspect-ratio:4/5}.digital-image-caption{margin:12px 0 0}
</style>
