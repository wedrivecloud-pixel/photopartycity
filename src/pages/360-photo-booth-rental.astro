---
import RentalLayout from '../layouts/RentalLayout.astro';
import FAQ from '../components/redesign/FAQ.astro';
import {bookingLinks,booth360Rates,money,serviceSchema} from '../data/rentals';
const title = "360 Photo Booth Rental | Inland Empire | Photo Party City";
const description = "Compare full-service and self-service 360 video booth rentals for Inland Empire weddings, company events, and parties. See rates and request your event proposal.";
const canonical = "https://photopartycity.com/360-photo-booth-rental/";
const faqs = [
  {question:"Is a 360 booth the same as a photo booth with prints?",answer:`No. 360 is all about video. For printed keepsakes, pick a full‑service photo booth.`},
  {question:"Is an attendant included?",answer:`Full service includes professional setup; guest support is confirmed in your proposal. Self‑service is run by you or a helper.`},
  {question:"Can I rent a 360 booth for 24 hours?",answer:`360 rentals come in 2, 3 or 4 hours. For a 24‑hour rental, see our self‑service photo booths.`},
  {question:"Can we use our branding?",answer:`Yes. Every rental includes a custom template — send your artwork and event name.`},
  {question:"Does checking my date reserve it?",answer:`Not yet. Your date is reserved once you approve the proposal and book.`},
];
const schema = serviceSchema("360 video booth rental",canonical,[...Object.entries(booth360Rates.full).map(([hours,price]) => ({name:`360 full service — ${hours} hours`,price,href:bookingLinks.booth360})), ...Object.entries(booth360Rates.self).map(([hours,price]) => ({name:`360 self-service — ${hours} hours`,price,href:bookingLinks.booth360}))]);
---
<RentalLayout title={title} description={description} canonical={canonical} image="/media/0a778edc2fc58d57.webp" schema={schema} breadcrumbs={[{name:'Home',href:'/'},{name:'Ways to rent',href:'/photo-booth-packages/'},{name:"360 video booth"}]} checkHref={bookingLinks.booth360}>


<section style="padding-block: 24px clamp(56px, 7vw, 96px)">
<div class="ppc-wrap ppc-hero">
<div class="ppc-stack" style="gap: 22px">
<span class="ppc-tag">Within 45 mi of Mira Loma</span>
<h1 class="ppc-h1">360 video booth rental in the Inland Empire.</h1>
<p class="ppc-lead">Guests step on the platform, the camera circles them, creating a short video they can share.</p>
<div class="ppc-row">
<a class="ppc-btnp" href={bookingLinks.booth360} data-source="hero" data-booth="360">Check your date</a>
<a class="ppc-link" href="tel:+19094037143" data-source="hero" data-booth="360">Call or text (909) 403-7143</a>
</div>
<ul class="ppc-checks ppc-checks-row"><li>2, 3 or 4 hours</li><li>Custom video template</li><li>Instant sharing</li></ul>
</div>
<div class="ppc-ph t-lil ppc-r45" style="border-radius: 28px"><span>Photo: friends cheering mid‑spin on the platform</span></div>
</div>
</section>

<section class="ppc-section-sm ppc-white" aria-labelledby="use-h">
<div class="ppc-wrap ppc-stack-lg">
<h2 id="use-h" class="ppc-h2">Where 360 shines</h2>
<div class="ppc-grid3">
<div class="ppc-stack" style="gap: 8px"><h3 class="ppc-h3">Weddings &amp; milestones</h3><p class="ppc-p">Open the platform after dinner and toasts, when the dance floor fills up.</p></div>
<div class="ppc-stack" style="gap: 8px"><h3 class="ppc-h3">Company celebrations</h3><p class="ppc-p">Your logo and event name on every video template.</p></div>
<div class="ppc-stack" style="gap: 8px"><h3 class="ppc-h3">Birthdays &amp; parties</h3><p class="ppc-p">Group spins, slow‑mo confetti, instant replays.</p></div>
</div>
</div>
</section>

<section id="rates" class="ppc-section" aria-labelledby="rates-h">
<div class="ppc-wrap ppc-stack-lg">
<div class="ppc-stack" style="gap: 12px">
<h2 id="rates-h" class="ppc-h2">Pick who runs it and for how long</h2>
<p class="ppc-p">Both include a custom template plus video capture and sharing.</p>
</div>
<div class="ppc-grid2">
<article class="ppc-tier is-feature" data-360-rates={JSON.stringify(booth360Rates.full)}>
<div class="ppc-ph t-blush ppc-r169"><span>Photo: wedding guests on the 360 platform</span></div>
<div class="ppc-tier-body">
<p class="ppc-eyebrow">We set it up</p>
<h3 class="ppc-h3" style="font-size: 28px">360 full service</h3>
<ul class="ppc-checks"><li>Professional setup included</li><li>Custom template</li><li>Video capture and sharing</li></ul>
<div class="ppc-seg" role="group" aria-label="Full-service booth time" style="display: flex; gap: 4px; max-width: 360px; margin-top: 8px; padding: 5px; border-radius: 999px; background: #FBF7F0; border: 1px solid #E2D9CC">
{([2, 3, 4] as const).map(hours => <button type="button" data-hours={hours} aria-pressed={hours === 2} style="flex:1;min-height:44px;padding:8px 12px;border:0;border-radius:999px;font:inherit;font-size:15px;font-weight:700">{hours} hrs</button>)}
</div>
</div>
<div class="ppc-tier-foot"><p class="ppc-price" aria-live="polite"><b data-rate-price>{money(booth360Rates.full[2])}</b><span data-rate-duration>for 2 hours</span></p><a class="ppc-btnp ppc-btn-sm" href="/check-your-date/?booth=360-full&amp;hours=2" data-rate-link data-source="card" data-booth="360">Check your date</a></div>
</article>
<article class="ppc-tier" data-360-rates={JSON.stringify(booth360Rates.self)}>
<div class="ppc-ph t-sage ppc-r169"><span>Photo: kids spinning at a backyard party</span></div>
<div class="ppc-tier-body">
<p class="ppc-eyebrow">You run it</p>
<h3 class="ppc-h3" style="font-size: 28px">360 self‑service</h3>
<ul class="ppc-checks"><li>Pickup and return in Mira Loma</li><li>Custom template</li><li>Video capture and sharing</li></ul>
<div class="ppc-seg" role="group" aria-label="Self-service booth time" style="display: flex; gap: 4px; max-width: 360px; margin-top: 8px; padding: 5px; border-radius: 999px; background: #FBF7F0; border: 1px solid #E2D9CC">
{([2, 3, 4] as const).map(hours => <button type="button" data-hours={hours} aria-pressed={hours === 2} style="flex:1;min-height:44px;padding:8px 12px;border:0;border-radius:999px;font:inherit;font-size:15px;font-weight:700">{hours} hrs</button>)}
</div>
</div>
<div class="ppc-tier-foot"><p class="ppc-price" aria-live="polite"><b data-rate-price>{money(booth360Rates.self[2])}</b><span data-rate-duration>for 2 hours</span></p><a class="ppc-btng ppc-btn-sm" href="/check-your-date/?booth=360-self&amp;hours=2" data-rate-link data-source="card" data-booth="360">Check your date</a></div>
</article>
<noscript><p class="ppc-small">With JavaScript disabled, the cards show the two-hour rate. <a href="/photo-booth-packages/#v360">See all 360 rates</a>, then choose your hours when you check your date.</p></noscript>
</div>
</div>
</section>

<section class="ppc-section ppc-band" aria-labelledby="space-h">
<div class="ppc-wrap ppc-split ppc-split-top">
<div class="ppc-stack" style="gap: 14px">
<h2 id="space-h" class="ppc-h2">Plan room for the platform and arm</h2>
<p class="ppc-p">The arm sweeps a full circle, so the booth needs clear space around it. We confirm the layout with you before booking.</p>
</div>
<div class="ppc-stack" style="gap: 20px">
<div class="ppc-card ppc-stack" style="gap: 6px"><h3 class="ppc-h4">Placement &amp; guest flow</h3><p class="ppc-p" style="font-size: 16px">A spot with room for a short line, away from food service and exits.</p></div>
<div class="ppc-card ppc-stack" style="gap: 6px"><h3 class="ppc-h4">Power &amp; sharing</h3><p class="ppc-p" style="font-size: 16px">A nearby outlet, plus venue internet for instant sharing.</p></div>
<div class="ppc-card ppc-stack" style="gap: 6px"><h3 class="ppc-h4">Setup &amp; removal</h3><p class="ppc-p" style="font-size: 16px">Your address, loading route, access window and any outdoor cover.</p></div>
</div>
</div>
</section>

<section class="ppc-section" aria-labelledby="faq-h">
<div class="ppc-wrap ppc-faqgrid">
<div class="ppc-stack"><h2 id="faq-h" class="ppc-h2">360 booth questions</h2><p class="ppc-p">Something else? <a href="tel:+19094037143" style="font-weight: 600" data-source="section" data-booth="360">Call or text (909) 403-7143</a>.</p></div>
<FAQ items={faqs} bare />
</div>
</section>

</RentalLayout>
<style>
  [data-360-rates] .ppc-seg button {background:transparent;color:var(--muted)}
  [data-360-rates] .ppc-seg button[aria-pressed="true"] {background:var(--accent);color:#fff}
</style>
<script>
 document.querySelectorAll<HTMLElement>('[data-360-rates]').forEach(card => {
   const rates = JSON.parse(card.dataset['360Rates'] || '{}') as Record<string, number>;
   const controls = card.querySelectorAll<HTMLButtonElement>('[data-hours]');
   controls.forEach(button => button.addEventListener('click', () => {
     const hours = button.dataset.hours || '2';
     controls.forEach(control => control.setAttribute('aria-pressed', String(control === button)));
     const price = card.querySelector('[data-rate-price]');
     const duration = card.querySelector('[data-rate-duration]');
     const link = card.querySelector<HTMLAnchorElement>('[data-rate-link]');
     if (price) price.textContent = new Intl.NumberFormat('en-US',{style:'currency',currency:'USD',maximumFractionDigits:0}).format(rates[hours]);
     if (duration) duration.textContent = `for ${hours} hours`;
     if (link) {const target = new URL(link.href); target.searchParams.set('hours',hours); link.href = target.toString();}
   }));
 });
</script>
